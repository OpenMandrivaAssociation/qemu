+static void qt_2d_refresh(DisplayChangeListener *dcl)
+{
+    QtConsole *vc = container_of(dcl, QtConsole, dcl);
+    qemu_console_hw_update(dcl->con);
+    qt_app_process_events(vc->s->app);
