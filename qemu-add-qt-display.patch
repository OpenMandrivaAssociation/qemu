+/* ---- init ---- */
+
+static void qt_mouse_mode_change(Notifier *notify, void *data)
+{
+    QtDisplayState *s = container_of(notify, QtDisplayState, mouse_mode_notifier);
+    QtConsole *vc = qt_vc_current(s);
+    (void)data;
+    if (!vc) {
+        return;
+    }
+    if (qemu_input_is_absolute(vc->dcl.con) && s->ptr_owner) {
+        qt_ungrab_pointer(s);
+    }
+    qt_vc_set_cursor_blank(vc->widget,
+        !s->show_cursor &&
+        (s->ptr_owner == vc || qemu_input_is_absolute(vc->dcl.con)));
+}
+
+static void qt_change_runstate(void *opaque, bool running, RunState state)
+{
+    (void)running;
+    (void)state;
+    qt_update_caption(opaque);
+}
+
+static void qt_display_early_init(DisplayOptions *opts)
+{
+    assert(opts->type == DISPLAY_TYPE_QT);
+
+    if (opts->has_gl && opts->gl != DISPLAY_GL_MODE_OFF) {
+#if defined(CONFIG_OPENGL)
+        display_opengl = 1;
+#else
+        error_report("OpenGL support is not available in this QEMU build");
+        exit(1);
+#endif
+    }
+}
+
+static void qt_display_init(DisplayState *ds, DisplayOptions *opts)
+{
+    QtDisplayState *s;
+    QtAppOptions app_opts;
+    QtAppCallbacks cb;
+    int i;
+
+    (void)ds;
+    assert(opts->type == DISPLAY_TYPE_QT);
+
+    s = g_new0(QtDisplayState, 1);
+    s->opts = opts;
+
+    s->show_cursor = opts->has_show_cursor && opts->show_cursor;
+    s->keep_aspect_ratio = true;
+    if (opts->u.qt.has_keep_aspect_ratio) {
+        s->keep_aspect_ratio = opts->u.qt.keep_aspect_ratio;
+    }
+    s->grab_on_hover = opts->u.qt.has_grab_on_hover && opts->u.qt.grab_on_hover;
+
+    memset(&app_opts, 0, sizeof(app_opts));
+    app_opts.full_screen = opts->has_full_screen && opts->full_screen;
+    app_opts.show_menubar = !opts->u.qt.has_show_menubar ||
+                            opts->u.qt.show_menubar;
+    app_opts.show_tabs = opts->u.qt.has_show_tabs && opts->u.qt.show_tabs;
+    app_opts.grab_on_hover = s->grab_on_hover;
+    app_opts.zoom_to_fit = opts->u.qt.has_zoom_to_fit && opts->u.qt.zoom_to_fit;
+    app_opts.show_cursor = s->show_cursor;
+    app_opts.use_opengl = display_opengl;
+    app_opts.gl_es = opts->has_gl && opts->gl == DISPLAY_GL_MODE_ES;
+    app_opts.window_title = qemu_name;
+
+    memset(&cb, 0, sizeof(cb));
+    cb.opaque = s;
+    cb.on_quit = cb_quit;
+    cb.on_pause_toggle = cb_pause;
+    cb.on_reset = cb_reset;
+    cb.on_powerdown = cb_powerdown;
+    cb.on_fullscreen = cb_fullscreen;
+    cb.on_grab = cb_grab;
+    cb.on_grab_on_hover = cb_grab_on_hover;
+    cb.on_zoom_in = cb_zoom_in;
+    cb.on_zoom_out = cb_zoom_out;
+    cb.on_zoom_fixed = cb_zoom_fixed;
+    cb.on_zoom_fit = cb_zoom_fit;
+    cb.on_show_tabs = cb_show_tabs;
+    cb.on_show_menubar = cb_show_menubar;
+    cb.on_detach_tab = cb_detach;
+    cb.on_switch_vc = cb_switch_vc;
+    cb.on_key = cb_key;
+    cb.on_mouse_move = cb_mouse_move;
+    cb.on_mouse_button = cb_mouse_button;
+    cb.on_mouse_wheel = cb_mouse_wheel;
+    cb.on_hover = cb_hover;
+    cb.on_focus_out = cb_focus_out;
+    cb.on_window_close = cb_window_close;
+#if defined(CONFIG_OPENGL)
+    cb.on_gl_paint = cb_gl_paint;
+#endif
+    cb.on_resize = cb_resize;
+
+    s->app = qt_app_create(&app_opts, &cb);
+    if (!s->app) {
+        error_report("qt: failed to create Qt application");
+        exit(1);
+    }
+#if defined(CONFIG_OPENGL)
+    if (display_opengl && !qt_app_gl_ready(s->app)) {
+        error_report("qt: OpenGL was requested (-display qt,gl=...) but no "
+                     "usable GL context could be created");
+        exit(1);
+    }
+#endif
+
+    /*
+     * Create widgets first, show the window (realizing GL contexts), then
+     * register display listeners.  virtio-gpu-gl may call into GL during
+     * listener registration, so a current context must already exist.
+     */
+    for (i = 0;; i++) {
+        QemuConsole *con = qemu_console_lookup_by_index(i);
+        QtConsole *vc;
+        bool graphic;
+
+        if (!con) {
+            break;
+        }
+        if (s->nb_vcs >= QT_MAX_VCS) {
+            warn_report("qt: too many consoles (max %d)", QT_MAX_VCS);
+            break;
+        }
+
+        vc = &s->vc[s->nb_vcs];
+        vc->s = s;
+        vc->index = i;
+        vc->label = qemu_console_get_label(con);
+        vc->preferred_scale = 1.0;
+        if (opts->u.qt.has_scale &&
+            opts->u.qt.scale >= QT_SCALE_MIN &&
+            opts->u.qt.scale <= QT_SCALE_MAX) {
+            vc->preferred_scale = opts->u.qt.scale;
+        }
+        vc->scale_x = vc->preferred_scale;
+        vc->scale_y = vc->preferred_scale;
+        vc->kbd = qkbd_state_init(con);
+        graphic = qemu_console_is_graphic(con);
+
+#if defined(CONFIG_OPENGL)
+        vc->opengl = display_opengl && graphic;
+#else
+        vc->opengl = false;
+#endif
+        vc->widget = qt_app_add_vc(s->app, i, vc->label, graphic);
+        s->nb_vcs++;
+    }
+
+    qt_update_caption(s);
+    qt_app_show(s->app);
+    qt_app_process_events(s->app);
+
+#if defined(CONFIG_OPENGL)
+    if (display_opengl) {
+        /*
+         * Activate master / widget contexts before devices start using
+         * DisplayGLCtx.  qemu_gl_init_shader() needs a live context for epoxy.
+         */
+        for (i = 0; i < s->nb_vcs; i++) {
+            QtConsole *vc = &s->vc[i];
+            if (!vc->opengl) {
+                continue;
+            }
+            if (!qt_vc_gl_realize(vc->widget)) {
+                error_report("qt: failed to realize OpenGL context for '%s' "
+                             "(falling back to 2D)",
+                             vc->label ? vc->label : "console");
+                vc->opengl = false;
+            } else if (!qt_gl_ensure_egl(vc)) {
+                error_report("qt: EGL export failed for '%s' "
+                             "(falling back to 2D)",
+                             vc->label ? vc->label : "console");
+                vc->opengl = false;
+            } else {
+                /*
+                 * Shaders/VAOs are created on first paintGL so they belong to
+                 * the QOpenGLWidget context (not a guest/surfaceless one).
+                 */
+                vc->has_dmabuf = qemu_egl_has_dmabuf();
+            }
+            qt_vc_gl_done_current(vc->widget);
+        }
+    }
+#endif
+
+    for (i = 0; i < s->nb_vcs; i++) {
+        QtConsole *vc = &s->vc[i];
+        QemuConsole *con = qemu_console_lookup_by_index(vc->index);
+
+#if defined(CONFIG_OPENGL)
+        if (vc->opengl) {
+            vc->dgc.ops = &qt_gl_ctx_ops;
+            qemu_console_set_display_gl_ctx(con, &vc->dgc);
+            qemu_console_register_listener(con, &vc->dcl, &qt_dcl_gl_ops);
+            /* Kick an initial paint once the surface is attached. */
+            vc->updates++;
+            qt_vc_gl_request_update(vc->widget);
+        } else
+#endif
+        {
+            qemu_console_register_listener(con, &vc->dcl, &qt_dcl_2d_ops);
+        }
+    }
+
+    qt_app_process_events(s->app);
+
+    /* Default zoom-to-fit like GTK when UI info is supported */
+    if (!opts->u.qt.has_zoom_to_fit && s->nb_vcs &&
+        qemu_console_ui_info_supported(s->vc[0].dcl.con)) {
+        s->free_scale = true;
+        for (i = 0; i < s->nb_vcs; i++) {
+            qt_vc_set_scales(s->vc[i].widget, s->vc[i].scale_x,
+                             s->vc[i].scale_y, true, s->keep_aspect_ratio);
+        }
+    } else if (app_opts.zoom_to_fit) {
+        s->free_scale = true;
+    }
+
+    /*
+     * Push initial *widget* size to the guest immediately (no 1s debounce).
+     * qt_app_show() already re-notified after layout; do it again now that
+     * listeners are registered and free_scale is set.
+     */
+    qt_app_notify_sizes(s->app);
+    for (i = 0; i < s->nb_vcs; i++) {
+        QtConsole *vc = &s->vc[i];
+        int ww = qt_vc_widget_width(vc->widget);
+        int wh = qt_vc_widget_height(vc->widget);
+        if (ww > 0 && wh > 0) {
+            qt_set_ui_size(vc, ww, wh, false);
+        }
+    }
+
+    s->mouse_mode_notifier.notify = qt_mouse_mode_change;
+    qemu_add_mouse_mode_change_notifier(&s->mouse_mode_notifier);
+    qemu_add_vm_change_state_handler(qt_change_runstate, s);
+
+    if (s->nb_vcs) {
+        qt_vc_set_focus(s->vc[0].widget);
+    }
+
+    /* Qt event processing runs from dpy_refresh via processEvents(). */
+    qemu_main = NULL;
+}
+
+static QemuDisplay qemu_display_qt = {
+    .type       = DISPLAY_TYPE_QT,
+    .early_init = qt_display_early_init,
+    .init       = qt_display_init,
+};
+
+static void register_qt(void)
+{
+    qemu_display_register(&qemu_display_qt);
+}
+
+type_init(register_qt);
+
+#if defined(CONFIG_OPENGL)
+module_dep("ui-opengl");
+#endif
