+static const DisplayChangeListenerOps qt_dcl_2d_ops = {
+    .dpy_name             = "qt-2d",
+    .dpy_refresh          = qt_2d_refresh,
+    .dpy_gfx_update       = qt_2d_update,
+    .dpy_gfx_switch       = qt_2d_switch,
+    .dpy_gfx_check_format = qt_2d_check_format,
+    .dpy_mouse_set        = qt_mouse_set,
+    .dpy_cursor_define    = qt_cursor_define,
+};
