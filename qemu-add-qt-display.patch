+#if defined(CONFIG_OPENGL)
+/*
+ * QOpenGLWidget only presents what is drawn inside paintGL(), and its
+ * default FBO is not GL FBO 0.  All guest presentation runs from the
+ * on_gl_paint callback; GL object creation for the 2D path also happens
+ * there so textures/FBOs belong to the widget context.
+ */
+
+static void qt_gl_widget_size(QtConsole *vc, int *ww, int *wh)
+{
+    /* Device-pixel FBO size — must match QOpenGLWidget's backing store. */
+    qt_vc_gl_fb_size(vc->widget, ww, wh);
+    if (*ww <= 0) {
+        *ww = vc->ds ? surface_width(vc->ds) : 640;
+    }
+    if (*wh <= 0) {
+        *wh = vc->ds ? surface_height(vc->ds) : 480;
+    }
+}
+
+static bool qt_gl_surface_format(DisplaySurface *ds,
+                                 GLenum *glformat, GLenum *gltype)
+{
+    switch (surface_format(ds)) {
+    case PIXMAN_BE_b8g8r8x8:
+    case PIXMAN_BE_b8g8r8a8:
+        *glformat = GL_BGRA;
+        *gltype = GL_UNSIGNED_BYTE;
+        return true;
+    case PIXMAN_BE_x8r8g8b8:
+    case PIXMAN_BE_a8r8g8b8:
+        *glformat = GL_RGBA;
+        *gltype = GL_UNSIGNED_BYTE;
+        return true;
+    case PIXMAN_r5g6b5:
+        *glformat = GL_RGB;
+        *gltype = GL_UNSIGNED_SHORT_5_6_5;
+        return true;
+    default:
+        return false;
+    }
+}
+
+/*
+ * Upload the 2D guest surface into a GL texture.  Avoid
+ * surface_gl_create_texture(): it calls glEnable(GL_TEXTURE_2D), which is
+ * invalid in core profiles and has left drivers in a bad state.
+ * Caller must hold the widget context (paintGL).
+ *
+ * Note on orientation: glTexImage2D treats the first memory row as the
+ * *bottom* of the GL texture.  Guest/pixman first row is the *top* of the
+ * screen, so presentation must flip Y (see qt_gl_paint).
+ */
+static bool qt_gl_upload_surface(QtConsole *vc)
+{
+    DisplaySurface *ds = vc->ds;
+    GLenum glformat, gltype;
+    int gw, gh, rowlen;
+    GLint tex_w = 0, tex_h = 0;
+
+    if (!ds || !qt_gl_surface_format(ds, &glformat, &gltype)) {
+        return false;
+    }
+
+    gw = surface_width(ds);
+    gh = surface_height(ds);
+    if (gw <= 0 || gh <= 0) {
+        return false;
+    }
+    rowlen = surface_stride(ds) / surface_bytes_per_pixel(ds);
+
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+    glPixelStorei(GL_UNPACK_ROW_LENGTH, rowlen);
+
+    if (ds->texture) {
+        glBindTexture(GL_TEXTURE_2D, ds->texture);
+        glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_WIDTH, &tex_w);
+        glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_HEIGHT, &tex_h);
+        if (tex_w != gw || tex_h != gh) {
+            glDeleteTextures(1, &ds->texture);
+            ds->texture = 0;
+        }
+    }
+
+    if (!ds->texture) {
+        GLuint tex = 0;
+        glGenTextures(1, &tex);
+        glBindTexture(GL_TEXTURE_2D, tex);
+        /* LINEAR matches SDL/GTK scaled presentation better than NEAREST. */
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        /*
+         * xRGB guest formats often have alpha = 0.  Force A=1 when sampling
+         * so blits cannot make the window transparent.
+         */
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_A, GL_ONE);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, gw, gh, 0,
+                     glformat, gltype, surface_data(ds));
+        ds->texture = tex;
+    } else {
+        glBindTexture(GL_TEXTURE_2D, ds->texture);
+        glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, gw, gh,
+                        glformat, gltype, surface_data(ds));
+    }
+
+    glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+    vc->tex_upload_full = false;
+    return ds->texture != 0;
+}
+
+/* Letterbox guest (gw x gh) into widget (ww x wh); offsets from bottom-left. */
+static void qt_gl_letterbox(int ww, int wh, int gw, int gh,
+                            int *vx, int *vy, int *vw, int *vh)
+{
+    float sx, sy, s;
+
+    if (gw <= 0 || gh <= 0) {
+        *vx = 0;
+        *vy = 0;
+        *vw = ww;
+        *vh = wh;
+        return;
+    }
+    sx = (float)ww / (float)gw;
+    sy = (float)wh / (float)gh;
+    s = sx < sy ? sx : sy;
+    *vw = MAX(1, (int)(gw * s));
+    *vh = MAX(1, (int)(gh * s));
+    *vx = (ww - *vw) / 2;
+    *vy = (wh - *vh) / 2; /* bottom-left origin, same as glBlitFramebuffer */
+}
+
+static bool qt_gl_ensure_resources(QtConsole *vc)
+{
+    if (!qemu_egl_display) {
+        qemu_egl_display = eglGetCurrentDisplay();
+    }
+    if (!vc->gls) {
+        vc->gls = qemu_gl_init_shader();
+        vc->has_dmabuf = qemu_egl_has_dmabuf();
+    }
+    return vc->gls != NULL;
+}
+
+static void qt_set_scanout_mode(QtConsole *vc, bool scanout)
+{
+    if (vc->scanout_mode == scanout) {
+        return;
+    }
+    vc->scanout_mode = scanout;
+    if (!vc->scanout_mode) {
+        /* Drop scanout FBO name; paintGL recreates if needed. No GL calls. */
+        vc->guest_fb.texture = 0;
+        vc->guest_fb.framebuffer = 0;
+        if (vc->ds) {
+            vc->tex_upload_full = true;
+        }
+    }
+}
+
+static void qt_gl_update(DisplayChangeListener *dcl,
+                         int x, int y, int w, int h)
+{
+    QtConsole *vc = container_of(dcl, QtConsole, dcl);
+    (void)x;
+    (void)y;
+    (void)w;
+    (void)h;
+    vc->tex_upload_full = true;
+    vc->updates++;
+    qt_vc_gl_request_update(vc->widget);
+}
+
+static void qt_gl_switch(DisplayChangeListener *dcl, DisplaySurface *surf)
+{
+    QtConsole *vc = container_of(dcl, QtConsole, dcl);
+
+    /*
+     * Do NOT clear scanout_mode here.  virtio-gpu-gl routinely calls
+     * qemu_console_set_surface(con, NULL) when using GL scanout, which
+     * installs the "Display output is not active." placeholder and invokes
+     * dpy_gfx_switch.  GTK keeps scanout running across that.
+     * Scanout ends only via dpy_gl_scanout_disable.
+     */
+    if (vc->ds) {
+        vc->ds->texture = 0;
+    }
+    vc->ds = surf;
+    if (surf) {
+        surf->texture = 0;
+        if (!vc->scanout_mode) {
+            qt_update_windowsize(vc);
+            /*
+             * Do not force a 2D repaint of the placeholder while GL scanout
+             * is (or will be) the real path — that flashed "not active".
+             */
+            if (!surface_is_placeholder(surf)) {
+                vc->tex_upload_full = true;
+                vc->updates++;
+            }
+        }
+    }
+    if (!vc->scanout_mode) {
+        qt_vc_gl_request_update(vc->widget);
+    }
+}
+
+/*
+ * Blit a guest texture region into the widget FBO.
+ * src_* are in the READ texture/FBO; flip_y swaps the source Y range
+ * (needed when guest top-left does not match GL bottom-left).
+ */
+/*
+ * Guest surfaces are often xRGB (undefined / zero alpha).  glBlitFramebuffer
+ * copies that alpha into the widget FBO; with an RGBA window format the
+ * compositor then treats the guest as fully transparent — only pixels that
+ * happen to have alpha (e.g. parts of the TianoCore logo) show, and the rest
+ * of the QEMU window is a glass pane over the desktop.
+ */
+static void qt_gl_force_opaque_alpha(GLuint widget_fbo, int widget_w, int widget_h)
+{
+    glBindFramebuffer(GL_FRAMEBUFFER, widget_fbo);
+    glViewport(0, 0, widget_w, widget_h);
+    glDisable(GL_SCISSOR_TEST);
+    glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_TRUE);
+    glClearColor(0.f, 0.f, 0.f, 1.f);
+    glClear(GL_COLOR_BUFFER_BIT);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+}
+
+static void qt_gl_blit_to_widget(GLuint widget_fbo,
+                                 GLuint read_fbo,
+                                 int src_x1, int src_y1, int src_x2, int src_y2,
+                                 int dst_x, int dst_y, int dst_w, int dst_h,
+                                 int widget_w, int widget_h)
+{
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, read_fbo);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, widget_fbo);
+    glViewport(0, 0, widget_w, widget_h);
+    /*
+     * Do not clear here — caller already cleared the full FBO.  Clearing
+     * again with a smaller viewport is harmless but wasteful.
+     */
+    {
+        bool scale = (dst_w != abs(src_x2 - src_x1)) ||
+                     (dst_h != abs(src_y2 - src_y1));
+        glBlitFramebuffer(src_x1, src_y1, src_x2, src_y2,
+                          dst_x, dst_y, dst_x + dst_w, dst_y + dst_h,
+                          GL_COLOR_BUFFER_BIT,
+                          scale ? GL_LINEAR : GL_NEAREST);
+    }
+    qt_gl_force_opaque_alpha(widget_fbo, widget_w, widget_h);
+}
+
+/* paintGL: widget context current, widget FBO already bound by Qt. */
+static void qt_gl_paint(QtConsole *vc)
+{
+    int ww, wh;
+    GLuint widget_fbo;
+    int vx, vy, vw, vh;
+
+    qt_gl_widget_size(vc, &ww, &wh);
+    widget_fbo = qt_vc_gl_default_framebuffer(vc->widget);
+    if (widget_fbo) {
+        glBindFramebuffer(GL_FRAMEBUFFER, widget_fbo);
+    }
+    /* Always clear the *entire* device-pixel FBO first (opaque). */
+    glViewport(0, 0, ww, wh);
+    glDisable(GL_SCISSOR_TEST);
+    glClearColor(0.f, 0.f, 0.f, 1.f);
+    glClear(GL_COLOR_BUFFER_BIT);
+
+    if (!qt_gl_ensure_resources(vc)) {
+        return;
+    }
+
+    /*
+     * Prefer GL scanout over the 2D surface.  While scanout is active the
+     * console surface is often the inactive placeholder — ignore it for
+     * presentation (same as GTK).
+     */
+    if (vc->scanout_mode && vc->guest_fb.texture) {
+        int fbw = vc->w > 0 ? (int)vc->w : vc->guest_fb.width;
+        int fbh = vc->h > 0 ? (int)vc->h : vc->guest_fb.height;
+        int sx = vc->x;
+        int sy = vc->y;
+        int y1, y2;
+
+        if (fbw <= 0 || fbh <= 0) {
+            return;
+        }
+
+        /*
+         * Attach the (shared) guest texture for reading.  Blit only the
+         * scanout rectangle — not the whole backing store — matching GTK.
+         *
+         * Do not touch GL_TEXTURE_SWIZZLE on guest/virgl textures (shared
+         * objects); force opaque alpha on the *destination* after blit.
+         */
+        egl_fb_setup_for_tex(&vc->guest_fb, vc->guest_fb.width,
+                             vc->guest_fb.height, vc->guest_fb.texture,
+                             false);
+
+        qt_gl_letterbox(ww, wh, fbw, fbh, &vx, &vy, &vw, &vh);
+
+        /*
+         * y0_top: guest y increases downward from the top of the image.
+         * GL blit source y increases upward from the bottom of the texture.
+         * Same rule as gd_gl_area_draw / egl_fb_blit(..., !y0_top).
+         */
+        if (vc->y0_top) {
+            y1 = sy;
+            y2 = sy + fbh;
+        } else {
+            y1 = sy + fbh;
+            y2 = sy;
+        }
+
+        qt_gl_blit_to_widget(widget_fbo, vc->guest_fb.framebuffer,
+                             sx, y1, sx + fbw, y2,
+                             vx, vy, vw, vh, ww, wh);
+
+        /* Hardware cursor plane (virtio-gpu) — same as GTK egl path. */
+        if (vc->cursor_fb.texture && vc->gls) {
+            double sx_s = (double)vw / (double)fbw;
+            double sy_s = (double)vh / (double)fbh;
+            int cur_x = vx + (int)(vc->cursor_x * sx_s);
+            /* egl_texture_blend treats y as top-down within dst->height. */
+            int cur_y = (wh - vy - vh) + (int)(vc->cursor_y * sy_s);
+            egl_fb win = {
+                .width = ww,
+                .height = wh,
+                .x = 0,
+                .y = 0,
+                .framebuffer = widget_fbo,
+            };
+            egl_texture_blend(vc->gls, &win, &vc->cursor_fb, false,
+                              cur_x, cur_y, sx_s, sy_s);
+            while (glGetError() != GL_NO_ERROR) {
+                /* drain core-profile noise from glEnable(GL_TEXTURE_2D) */
+            }
+            /* Blend may have touched alpha; keep the window opaque. */
+            qt_gl_force_opaque_alpha(widget_fbo, ww, wh);
+        }
+
+#ifdef CONFIG_GBM
+        /*
+         * Optional: create a fence for the guest without hw_gl_block.
+         * Blocking the guest for Qt EGL fences blacked out the desktop
+         * (guest running, host window black).  A flush is enough for us.
+         */
+        if (vc->guest_fb.dmabuf) {
+            glFlush();
+        }
+#endif
+        return;
+    }
+
+    if (vc->ds) {
+        int gw = surface_width(vc->ds);
+        int gh = surface_height(vc->ds);
+
+        if (!vc->ds->texture || vc->tex_upload_full) {
+            if (!qt_gl_upload_surface(vc)) {
+                return;
+            }
+        }
+
+        qt_gl_letterbox(ww, wh, gw, gh, &vx, &vy, &vw, &vh);
+
+        /*
+         * Persistent READ FBO for the surface texture.  Flip Y: first
+         * uploaded row is guest top, but GL treats it as texture bottom.
+         */
+        egl_fb_setup_for_tex(&vc->guest_fb, gw, gh, vc->ds->texture, false);
+        qt_gl_blit_to_widget(widget_fbo, vc->guest_fb.framebuffer,
+                             0, gh, gw, 0,   /* flip Y */
+                             vx, vy, vw, vh, ww, wh);
+        return;
+    }
+}
+
+static void cb_gl_paint(void *opaque, int vc_index)
+{
+    QtDisplayState *s = opaque;
+    QtConsole *vc = qt_vc_by_index(s, vc_index);
+
+    if (!vc || !vc->opengl) {
+        return;
+    }
+    qt_gl_paint(vc);
+}
+
+static void qt_gl_refresh(DisplayChangeListener *dcl)
+{
+    QtConsole *vc = container_of(dcl, QtConsole, dcl);
+    qemu_console_hw_update(dcl->con);
+    /*
+     * Repaint when the guest dirtied the display, or whenever we are in
+     * scanout (cursor moves without a gfx_update).  Avoid unconditional
+     * every-tick paints — that amplified boot-time flicker.
+     */
+    if (vc->updates || vc->scanout_mode || vc->cursor_fb.texture) {
+        vc->updates = 0;
+        qt_vc_gl_request_update(vc->widget);
+    }
+    qt_app_process_events(vc->s->app);
+}
+
+static void qt_gl_scanout_disable(DisplayChangeListener *dcl)
+{
+    QtConsole *vc = container_of(dcl, QtConsole, dcl);
+    vc->w = 0;
+    vc->h = 0;
+    qt_set_scanout_mode(vc, false);
+    qt_vc_gl_request_update(vc->widget);
+}
+
+static void qt_gl_scanout_texture(DisplayChangeListener *dcl,
+                                  uint32_t backing_id,
+                                  bool backing_y_0_top,
+                                  uint32_t backing_width,
+                                  uint32_t backing_height,
+                                  uint32_t x, uint32_t y,
+                                  uint32_t w, uint32_t h,
+                                  void *d3d_tex2d)
+{
+    QtConsole *vc = container_of(dcl, QtConsole, dcl);
+    (void)d3d_tex2d;
+    vc->x = x;
+    vc->y = y;
+    vc->w = w;
+    vc->h = h;
+    vc->y0_top = backing_y_0_top;
+    vc->scanout_mode = true;
+    vc->guest_fb.texture = backing_id;
+    vc->guest_fb.width = backing_width;
+    vc->guest_fb.height = backing_height;
+    vc->guest_fb.delete_texture = false;
+    vc->guest_fb.framebuffer = 0; /* reattach in paint/flush (FBO not shared) */
+
+    /*
+     * Like SDL: make a context current and attach the texture now so we fail
+     * early if the tex id is not visible in our share group.
+     */
+    if (backing_id && qt_vc_gl_make_current(vc->widget)) {
+        if (!glIsTexture(backing_id)) {
+            error_report("qt: scanout texture %u is not a GL texture "
+                         "(share-group mismatch?)", backing_id);
+        } else {
+            egl_fb_setup_for_tex(&vc->guest_fb, backing_width, backing_height,
+                                 backing_id, false);
+        }
+        qt_vc_gl_done_current(vc->widget);
+    }
+    qt_vc_gl_request_update(vc->widget);
+}
+
+static void qt_gl_scanout_flush(DisplayChangeListener *dcl,
+                                uint32_t x, uint32_t y, uint32_t w, uint32_t h)
+{
+    QtConsole *vc = container_of(dcl, QtConsole, dcl);
+    (void)x;
+    (void)y;
+    (void)w;
+    (void)h;
+    if (!vc->scanout_mode || !vc->guest_fb.texture) {
+        return;
+    }
+    /*
+     * Present immediately (like SDL).  Relying only on QOpenGLWidget::update()
+     * deferred paint can leave the placeholder on screen while the guest
+     * already has an active scanout.
+     */
+    if (qt_vc_gl_make_current(vc->widget)) {
+        qt_gl_paint(vc);
+        qt_vc_gl_done_current(vc->widget);
+    }
+    qt_vc_gl_request_update(vc->widget);
+}
+
+#ifdef CONFIG_GBM
+static void qt_gl_scanout_dmabuf(DisplayChangeListener *dcl,
+                                 QemuDmaBuf *dmabuf)
+{
+    QtConsole *vc = container_of(dcl, QtConsole, dcl);
+    uint32_t x, y, width, height, bw, bh, texture;
+    bool y0_top;
+
+    /*
+     * Import requires a current context; use the widget context.  The
+     * resulting GL texture is then recorded for paintGL blit.
+     */
+    if (!qt_vc_gl_make_current(vc->widget)) {
+        return;
+    }
+    egl_dmabuf_import_texture(dmabuf);
+    texture = qemu_dmabuf_get_texture(dmabuf);
+    if (!texture) {
+        error_report("qt: dmabuf import failed");
+        qt_vc_gl_done_current(vc->widget);
+        return;
+    }
+    x = qemu_dmabuf_get_x(dmabuf);
+    y = qemu_dmabuf_get_y(dmabuf);
+    width = qemu_dmabuf_get_width(dmabuf);
+    height = qemu_dmabuf_get_height(dmabuf);
+    bw = qemu_dmabuf_get_backing_width(dmabuf);
+    bh = qemu_dmabuf_get_backing_height(dmabuf);
+    y0_top = qemu_dmabuf_get_y0_top(dmabuf);
+
+    qt_gl_scanout_texture(dcl, texture, y0_top, bw, bh,
+                          x, y, width, height, NULL);
+    if (qemu_dmabuf_get_allow_fences(dmabuf)) {
+        vc->guest_fb.dmabuf = dmabuf;
+    }
+    qt_vc_gl_done_current(vc->widget);
+    qt_vc_gl_request_update(vc->widget);
+}
+
+static void qt_gl_cursor_dmabuf(DisplayChangeListener *dcl,
+                                QemuDmaBuf *dmabuf, bool have_hot,
+                                uint32_t hot_x, uint32_t hot_y)
+{
+    QtConsole *vc = container_of(dcl, QtConsole, dcl);
+    uint32_t bw, bh, texture;
+
+    (void)have_hot;
+    (void)hot_x;
+    (void)hot_y;
+
+    if (!dmabuf) {
+        vc->cursor_fb.texture = 0;
+        vc->cursor_fb.framebuffer = 0;
+        qt_vc_gl_request_update(vc->widget);
+        return;
+    }
+
+    if (!qt_vc_gl_make_current(vc->widget)) {
+        return;
+    }
+    egl_dmabuf_import_texture(dmabuf);
+    texture = qemu_dmabuf_get_texture(dmabuf);
+    if (!texture) {
+        qt_vc_gl_done_current(vc->widget);
+        return;
+    }
+    bw = qemu_dmabuf_get_backing_width(dmabuf);
+    bh = qemu_dmabuf_get_backing_height(dmabuf);
+    /* FBO is re-created in paintGL; only keep the shared texture id. */
+    vc->cursor_fb.texture = texture;
+    vc->cursor_fb.width = bw;
+    vc->cursor_fb.height = bh;
+    vc->cursor_fb.delete_texture = false;
+    vc->cursor_fb.framebuffer = 0;
+    qt_vc_gl_done_current(vc->widget);
+    /* Hide host pointer; guest cursor is composited in paintGL. */
+    qt_vc_set_cursor_blank(vc->widget, true);
+    qt_vc_gl_request_update(vc->widget);
+}
+
+static void qt_gl_cursor_position(DisplayChangeListener *dcl,
+                                  uint32_t pos_x, uint32_t pos_y)
+{
+    QtConsole *vc = container_of(dcl, QtConsole, dcl);
+
+    vc->cursor_x = pos_x;
+    vc->cursor_y = pos_y;
+    qt_vc_gl_request_update(vc->widget);
+}
+
+static void qt_gl_release_dmabuf(DisplayChangeListener *dcl,
+                                 QemuDmaBuf *dmabuf)
+{
+    (void)dcl;
+    egl_dmabuf_release_texture(dmabuf);
+}
+
+static bool qt_gl_has_dmabuf(DisplayChangeListener *dcl)
+{
+    QtConsole *vc = container_of(dcl, QtConsole, dcl);
+
+    /*
+     * Probe once we have a current EGL display.  Returning false forever
+     * (initial zeroed flag) can break consoles that require DMABUF flags.
+     */
+    if (!vc->has_dmabuf) {
+        if (!qemu_egl_display && qt_vc_gl_make_current(vc->widget)) {
+            qemu_egl_display = eglGetCurrentDisplay();
+            qt_vc_gl_done_current(vc->widget);
+        }
+        if (qemu_egl_display) {
+            vc->has_dmabuf = qemu_egl_has_dmabuf();
+        }
+    }
+    return vc->has_dmabuf;
+}
+#endif
+
+/*
+ * Bind QEMU's global EGL state to Qt's native EGL display/config so
+ * qemu_egl_create_context / make_context_current (surfaceless) can run
+ * guest/virgl work the same way GTK and spice do.  Presentation stays on
+ * QOpenGLWidget; only guest contexts use raw EGL.
+ */
+static bool qt_gl_ensure_egl(QtConsole *vc)
+{
+    void *dpy;
+    void *cfg;
+    bool gles = false;
+
+    if (qemu_egl_display && qemu_egl_config) {
+        return true;
+    }
+
+    if (!qt_app_gl_has_egl(vc->s->app)) {
+        error_report("qt: Qt is not using EGL (set QT_XCB_GL_INTEGRATION=xcb_egl); "
+                     "guest GL requires EGL");
+        return false;
+    }
+
+    dpy = qt_app_gl_egl_display(vc->s->app);
+    cfg = qt_app_gl_egl_config(vc->s->app);
+    if (!dpy || !cfg) {
+        error_report("qt: failed to export Qt EGL display/config for guest GL");
+        return false;
+    }
+
+    if (vc->s->opts->has_gl && vc->s->opts->gl == DISPLAY_GL_MODE_ES) {
+        gles = true;
+    }
+
+    qemu_egl_display = dpy;
+    qemu_egl_config = cfg;
+    qemu_egl_mode = gles ? DISPLAY_GL_MODE_ES : DISPLAY_GL_MODE_CORE;
+
+    if (!eglBindAPI(gles ? EGL_OPENGL_ES_API : EGL_OPENGL_API)) {
+        error_report("qt: eglBindAPI failed: %s", qemu_egl_get_error_string());
+        return false;
+    }
+    return true;
+}
+
+static QEMUGLContext qt_gl_create_context(DisplayGLCtx *dgc,
+                                          QEMUGLParams *params)
+{
+    QtConsole *vc = container_of(dgc, QtConsole, dgc);
+    void *share;
+    QEMUGLContext ctx;
+
+    if (!qt_gl_ensure_egl(vc)) {
+        return NULL;
+    }
+
+    share = qt_vc_gl_share_egl_context(vc->widget);
+    if (!share) {
+        error_report("qt: no native EGL share context for guest GL");
+        return NULL;
+    }
+
+    ctx = qemu_egl_create_context(dgc, params, share);
+    if (!ctx) {
+        error_report("qt: eglCreateContext for guest failed: %s",
+                     qemu_egl_get_error_string());
+    }
+    return ctx;
+}
+
+static void qt_gl_destroy_context(DisplayGLCtx *dgc, QEMUGLContext ctx)
+{
+    qemu_egl_destroy_context(dgc, ctx);
+}
+
+static int qt_gl_make_context_current(DisplayGLCtx *dgc, QEMUGLContext ctx)
+{
+    /*
+     * Surfaceless makeCurrent — never QOpenGLContext/QOffscreenSurface.
+     * virgl issues many create/make_current pairs; the Qt path deadlocked
+     * under glxinfo / 3D clients.
+     */
+    return qemu_egl_make_context_current(dgc, ctx);
+}
+
+static bool qt_gl_is_compatible_dcl(DisplayGLCtx *dgc,
+                                    DisplayChangeListener *dcl)
+{
+    QtConsole *vc = container_of(dgc, QtConsole, dgc);
+    return dcl == &vc->dcl;
+}
+
+static const DisplayChangeListenerOps qt_dcl_gl_ops = {
+    .dpy_name                = "qt-gl",
+    .dpy_refresh             = qt_gl_refresh,
+    .dpy_gfx_update          = qt_gl_update,
+    .dpy_gfx_switch          = qt_gl_switch,
+    .dpy_gfx_check_format    = console_gl_check_format,
+    .dpy_mouse_set           = qt_mouse_set,
+    .dpy_cursor_define       = qt_cursor_define,
+    .dpy_gl_scanout_disable  = qt_gl_scanout_disable,
+    .dpy_gl_scanout_texture  = qt_gl_scanout_texture,
+#ifdef CONFIG_GBM
+    .dpy_has_dmabuf          = qt_gl_has_dmabuf,
+    .dpy_gl_scanout_dmabuf   = qt_gl_scanout_dmabuf,
+    .dpy_gl_cursor_dmabuf    = qt_gl_cursor_dmabuf,
+    .dpy_gl_cursor_position  = qt_gl_cursor_position,
+    .dpy_gl_release_dmabuf   = qt_gl_release_dmabuf,
+#endif
+    .dpy_gl_update           = qt_gl_scanout_flush,
+};
+
+static const DisplayGLCtxOps qt_gl_ctx_ops = {
+    .dpy_gl_ctx_is_compatible_dcl = qt_gl_is_compatible_dcl,
+    .dpy_gl_ctx_create            = qt_gl_create_context,
+    .dpy_gl_ctx_destroy           = qt_gl_destroy_context,
+    .dpy_gl_ctx_make_current      = qt_gl_make_context_current,
+};
+#endif /* CONFIG_OPENGL */
