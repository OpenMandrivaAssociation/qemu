+
+/*
+ * Do not include epoxy/gl.h or epoxy/egl.h here: Qt's qopengl* headers
+ * already pull in GL/gl.h / qopenglext.h and epoxy hard-errors on that.
+ * QEGLContext gives us the native handles we need.
+ */
+
+/* pixman format codes we care about (avoid pulling pixman headers) */
+#define QT_PIXMAN_x8r8g8b8 0x20028888
+#define QT_PIXMAN_a8r8g8b8 0x20038888
+#define QT_PIXMAN_r5g6b5   0x10020565
+
+struct QtVcWidget {
+    class DisplayWidget *widget;
+    class GLDisplayWidget *gl_widget;
+    QWidget *as_qwidget;
+    QMainWindow *detached;
+    int index;
+    bool graphic;
+    bool use_gl;
+    double scale_x;
+    double scale_y;
+    bool free_scale;
+    bool keep_aspect;
+    char *label;
+    /* Host arrow hidden (absolute tablet / grab); guest shape takes priority. */
+    bool prefer_blank;
+    /* Guest asked to hide the cursor (mouse_set on=0). */
+    bool guest_cursor_hidden;
+    bool mouse_grabbed;
+    QCursor *guest_cursor;
+};
+
+struct QtApp {
+    QApplication *app;
+    bool owns_app;
+    QMainWindow *window;
+    QTabWidget *tabs;
+    QMenuBar *menu_bar;
+    QMenu *view_menu;
+    QActionGroup *vc_group;
+    QAction *pause_action;
+    QAction *grab_action;
+    QAction *fullscreen_action;
+    QAction *show_tabs_action;
+    QAction *show_menubar_action;
+    QAction *zoom_fit_action;
+    /* Master GL context: valid before any QOpenGLWidget is realized. */
+    QOpenGLContext *gl_master;
+    QOffscreenSurface *gl_surface;
+    QtAppCallbacks cb;
+    QtAppOptions opts;
+    std::vector<QtVcWidget *> vcs;
+};
+
+static QtApp *g_app;
+
+/* -------------------------------------------------------------------------- */
+
+class DisplayWidget : public QWidget
+{
+public:
+    DisplayWidget(QtApp *app, QtVcWidget *vc, QWidget *parent = nullptr)
+        : QWidget(parent), m_app(app), m_vc(vc)
+    {
+        setAttribute(Qt::WA_OpaquePaintEvent);
+        setAttribute(Qt::WA_NoSystemBackground);
+        setFocusPolicy(Qt::StrongFocus);
+        setMouseTracking(true);
+        setMinimumSize(160, 100);
+        setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Expanding);
+    }
+
+    void setImage(const QImage &img)
+    {
+        m_image = img;
+        update();
+    }
+
+    void setScales(double sx, double sy, bool free_scale, bool keep_aspect)
+    {
+        m_vc->scale_x = sx;
+        m_vc->scale_y = sy;
+        m_vc->free_scale = free_scale;
+        m_vc->keep_aspect = keep_aspect;
+        update();
+    }
+
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this);
+        p.fillRect(rect(), Qt::black);
+        if (m_image.isNull()) {
+            return;
+        }
+        int fbw = m_image.width();
+        int fbh = m_image.height();
+        double sx = m_vc->scale_x;
+        double sy = m_vc->scale_y;
+        int ww = width();
+        int wh = height();
+
+        if (m_vc->free_scale || m_app->window->isFullScreen()) {
+            if (m_vc->keep_aspect) {
+                double s = qMin((double)ww / fbw, (double)wh / fbh);
+                sx = sy = s;
+            } else {
+                sx = (double)ww / fbw;
+                sy = (double)wh / fbh;
+            }
+        }
+        int dw = qRound(fbw * sx);
+        int dh = qRound(fbh * sy);
+        int ox = (ww - dw) / 2;
+        int oy = (wh - dh) / 2;
+        p.setRenderHint(QPainter::SmoothPixmapTransform, sx != 1.0 || sy != 1.0);
+        p.drawImage(QRect(ox, oy, dw, dh), m_image);
+    }
+
+    void keyPressEvent(QKeyEvent *ev) override { handleKey(ev, true); }
+    void keyReleaseEvent(QKeyEvent *ev) override { handleKey(ev, false); }
+    /*
+     * QWidget::event() consumes Tab/Backtab for focus chain navigation
+     * before keyPressEvent runs.  Return false so Tab reaches the guest
+     * (shell completion, etc.) like GTK/SDL.
+     */
+    bool focusNextPrevChild(bool next) override
+    {
+        (void)next;
+        return false;
+    }
+    void mouseMoveEvent(QMouseEvent *ev) override { handleMouseMove(ev); }
+    void mousePressEvent(QMouseEvent *ev) override { handleMouseButton(ev, true); }
+    void mouseReleaseEvent(QMouseEvent *ev) override { handleMouseButton(ev, false); }
+    void wheelEvent(QWheelEvent *ev) override
+    {
+        if (m_app->cb.on_mouse_wheel) {
+            QPoint d = ev->angleDelta();
+            m_app->cb.on_mouse_wheel(m_app->cb.opaque, m_vc->index, d.x(), d.y());
+        }
+        ev->accept();
+    }
+    void enterEvent(QEnterEvent *ev) override
+    {
+        QWidget::enterEvent(ev);
+        if (m_app->cb.on_hover) {
+            m_app->cb.on_hover(m_app->cb.opaque, m_vc->index, true);
+        }
+    }
+    void leaveEvent(QEvent *ev) override
+    {
+        QWidget::leaveEvent(ev);
+        /* Re-center if relative grab somehow let the pointer leave. */
+        if (m_vc && m_vc->mouse_grabbed) {
+            QPoint c = mapToGlobal(rect().center());
+            QCursor::setPos(c);
+        }
+        if (m_app->cb.on_hover) {
+            m_app->cb.on_hover(m_app->cb.opaque, m_vc->index, false);
+        }
+    }
+    void focusOutEvent(QFocusEvent *ev) override
+    {
+        QWidget::focusOutEvent(ev);
+        if (m_app->cb.on_focus_out) {
+            m_app->cb.on_focus_out(m_app->cb.opaque, m_vc->index);
+        }
+    }
+
+private:
+    void handleKey(QKeyEvent *ev, bool down)
+    {
+        /* Ctrl+Alt hotkeys (also work while input is grabbed) */
+        if (down && !ev->isAutoRepeat() &&
+            (ev->modifiers() & Qt::ControlModifier) &&
+            (ev->modifiers() & Qt::AltModifier)) {
+            switch (ev->key()) {
+            case Qt::Key_G:
+                if (m_app->grab_action) {
+                    m_app->grab_action->toggle();
+                }
+                ev->accept();
+                return;
+            case Qt::Key_F:
+                if (m_app->fullscreen_action) {
+                    m_app->fullscreen_action->toggle();
+                }
+                ev->accept();
+                return;
+            case Qt::Key_M:
+                if (m_app->show_menubar_action) {
+                    m_app->show_menubar_action->toggle();
+                }
+                ev->accept();
+                return;
+            case Qt::Key_Q:
+                if (m_app->cb.on_quit) {
+                    m_app->cb.on_quit(m_app->cb.opaque);
+                }
+                ev->accept();
+                return;
+            case Qt::Key_1: case Qt::Key_2: case Qt::Key_3:
+            case Qt::Key_4: case Qt::Key_5: case Qt::Key_6:
+            case Qt::Key_7: case Qt::Key_8: case Qt::Key_9: {
+                int n = ev->key() - Qt::Key_1;
+                if (n >= 0 && n < (int)m_app->vcs.size()) {
+                    qt_app_set_current_vc(m_app, m_app->vcs[n]->index);
+                    qt_vc_set_focus(m_app->vcs[n]);
+                }
+                ev->accept();
+                return;
+            }
+            case Qt::Key_Plus:
+            case Qt::Key_Equal:
+                if (m_app->cb.on_zoom_in) {
+                    m_app->cb.on_zoom_in(m_app->cb.opaque);
+                }
+                ev->accept();
+                return;
+            case Qt::Key_Minus:
+                if (m_app->cb.on_zoom_out) {
+                    m_app->cb.on_zoom_out(m_app->cb.opaque);
+                }
+                ev->accept();
+                return;
+            case Qt::Key_0:
+                if (m_app->cb.on_zoom_fixed) {
+                    m_app->cb.on_zoom_fixed(m_app->cb.opaque);
+                }
+                ev->accept();
+                return;
+            default:
+                break;
+            }
+        }
+
+        if (!m_app->cb.on_key) {
+            return;
+        }
+        QByteArray text = ev->text().toUtf8();
+        m_app->cb.on_key(m_app->cb.opaque, m_vc->index,
+                         (int)ev->nativeScanCode(), (int)ev->key(), down,
+                         !text.isEmpty() && down, text.constData());
+        ev->accept();
+    }
+
+    /*
+     * Pass raw widget coordinates; letterbox → guest mapping is done in
+     * qt.c together with the GL path (needs guest FB size / scanout).
+     */
+    void handleMouseMove(QMouseEvent *ev)
+    {
+        if (!m_app->cb.on_mouse_move) {
+            return;
+        }
+        m_app->cb.on_mouse_move(m_app->cb.opaque, m_vc->index,
+                                (int)ev->position().x(),
+                                (int)ev->position().y(),
+                                (int)ev->buttons(), width(), height());
+        ev->accept();
+    }
+
+    void handleMouseButton(QMouseEvent *ev, bool down)
+    {
+        if (!m_app->cb.on_mouse_button) {
+            return;
+        }
+        m_app->cb.on_mouse_button(m_app->cb.opaque, m_vc->index,
+                                  (int)ev->position().x(),
+                                  (int)ev->position().y(),
+                                  (int)ev->buttons(), down, width(), height());
+        ev->accept();
+    }
+
+    void resizeEvent(QResizeEvent *ev) override
+    {
+        QWidget::resizeEvent(ev);
+        if (m_app->cb.on_resize) {
+            m_app->cb.on_resize(m_app->cb.opaque, m_vc->index,
+                                width(), height());
+        }
+    }
+
+    QtApp *m_app;
+    QtVcWidget *m_vc;
+    QImage m_image;
+};
+
+class GLDisplayWidget : public QOpenGLWidget
+{
+public:
+    GLDisplayWidget(QtApp *app, QtVcWidget *vc, QWidget *parent = nullptr)
+        : QOpenGLWidget(parent), m_app(app), m_vc(vc)
+    {
+        setFocusPolicy(Qt::StrongFocus);
+        setMouseTracking(true);
+        setMinimumSize(160, 100);
+        setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Expanding);
+        /*
+         * NoPartialUpdate is faster but can leave the compositor-facing
+         * buffer empty: the guest is visible on screen (direct present) yet
+         * Spectacle/grim/etc. capture a black rectangle.  PartialUpdate keeps
+         * the FBO so the window surface tools sample still has pixels.
+         */
+        setUpdateBehavior(QOpenGLWidget::PartialUpdate);
+        setFormat(QSurfaceFormat::defaultFormat());
+        /*
+         * Opaque fills still matter if paintGL covers only part of the FBO
+         * (wrong DPR) — otherwise the desktop shows through when moving.
+         */
+        setAttribute(Qt::WA_OpaquePaintEvent, true);
+        setAttribute(Qt::WA_NoSystemBackground, true);
+        setAutoFillBackground(false);
+        /*
+         * Texture sharing with the master/offscreen context relies on
+         * Qt::AA_ShareOpenGLContexts (set before QApplication).  QOpenGLWidget
+         * creates its context on first makeCurrent()/show().
+         */
+    }
+
+    bool ensureContext()
+    {
+        if (!isValid()) {
+            /*
+             * Force native window creation so QOpenGLWidget can build its
+             * context.  Safe to call before the top-level window is visible.
+             */
+            winId();
+            if (windowHandle()) {
+                windowHandle()->create();
+            }
+        }
+        makeCurrent();
+        if (QOpenGLContext *cur = QOpenGLContext::currentContext()) {
+            if (cur->isValid()) {
+                return true;
+            }
+        }
+        /* Widget context not ready yet — master offscreen is enough for epoxy. */
+        if (m_app && m_app->gl_master && m_app->gl_surface) {
+            return m_app->gl_master->makeCurrent(m_app->gl_surface) &&
+                   QOpenGLContext::currentContext() != nullptr;
+        }
+        return false;
+    }
+
+protected:
+    void initializeGL() override
+    {
+        /* Widget context is current; epoxy can resolve entry points. */
+    }
+
+    void paintGL() override
+    {
+        /*
+         * QOpenGLWidget only presents what is drawn here.  The widget FBO is
+         * already bound (it is not GL FBO 0).  Hand off to QEMU so it can
+         * blit the guest texture / surface into this framebuffer.
+         */
+        if (m_app->cb.on_gl_paint) {
+            m_app->cb.on_gl_paint(m_app->cb.opaque, m_vc->index);
+        } else if (QOpenGLContext *ctx = QOpenGLContext::currentContext()) {
+            QOpenGLFunctions *f = ctx->functions();
+            if (f) {
+                f->glClearColor(0.f, 0.f, 0.f, 1.f);
+                f->glClear(GL_COLOR_BUFFER_BIT);
+            }
+        }
+    }
+
+    void keyPressEvent(QKeyEvent *ev) override { relayKey(ev, true); }
+    void keyReleaseEvent(QKeyEvent *ev) override { relayKey(ev, false); }
+    /* See DisplayWidget — do not steal Tab for host focus navigation. */
+    bool focusNextPrevChild(bool next) override
+    {
+        (void)next;
+        return false;
+    }
+    void mouseMoveEvent(QMouseEvent *ev) override
+    {
+        if (m_app->cb.on_mouse_move) {
+            m_app->cb.on_mouse_move(m_app->cb.opaque, m_vc->index,
+                                    (int)ev->position().x(),
+                                    (int)ev->position().y(),
+                                    (int)ev->buttons(), width(), height());
+        }
+        ev->accept();
+    }
+    void mousePressEvent(QMouseEvent *ev) override { relayBtn(ev, true); }
+    void mouseReleaseEvent(QMouseEvent *ev) override { relayBtn(ev, false); }
+    void wheelEvent(QWheelEvent *ev) override
+    {
+        if (m_app->cb.on_mouse_wheel) {
+            QPoint d = ev->angleDelta();
+            m_app->cb.on_mouse_wheel(m_app->cb.opaque, m_vc->index, d.x(), d.y());
+        }
+        ev->accept();
+    }
+    void enterEvent(QEnterEvent *ev) override
+    {
+        QOpenGLWidget::enterEvent(ev);
+        if (m_app->cb.on_hover) {
+            m_app->cb.on_hover(m_app->cb.opaque, m_vc->index, true);
+        }
+    }
+    void leaveEvent(QEvent *ev) override
+    {
+        QOpenGLWidget::leaveEvent(ev);
+        if (m_vc && m_vc->mouse_grabbed) {
+            QPoint c = mapToGlobal(rect().center());
+            QCursor::setPos(c);
+        }
+        if (m_app->cb.on_hover) {
+            m_app->cb.on_hover(m_app->cb.opaque, m_vc->index, false);
+        }
+    }
+    void focusOutEvent(QFocusEvent *ev) override
+    {
+        QOpenGLWidget::focusOutEvent(ev);
+        if (m_app->cb.on_focus_out) {
+            m_app->cb.on_focus_out(m_app->cb.opaque, m_vc->index);
+        }
+    }
+    void resizeEvent(QResizeEvent *ev) override
+    {
+        QOpenGLWidget::resizeEvent(ev);
+        if (m_app->cb.on_resize) {
+            m_app->cb.on_resize(m_app->cb.opaque, m_vc->index,
+                                width(), height());
+        }
+    }
+
+private:
+    void relayKey(QKeyEvent *ev, bool down)
+    {
+        /* Reuse the same hotkey path as the 2D widget via a temp DisplayWidget
+         * pattern: handle Ctrl+Alt here too. */
+        if (down && !ev->isAutoRepeat() &&
+            (ev->modifiers() & Qt::ControlModifier) &&
+            (ev->modifiers() & Qt::AltModifier)) {
+            switch (ev->key()) {
+            case Qt::Key_G:
+                if (m_app->grab_action) {
+                    m_app->grab_action->toggle();
+                }
+                ev->accept();
+                return;
+            case Qt::Key_F:
+                if (m_app->fullscreen_action) {
+                    m_app->fullscreen_action->toggle();
+                }
+                ev->accept();
+                return;
+            case Qt::Key_Q:
+                if (m_app->cb.on_quit) {
+                    m_app->cb.on_quit(m_app->cb.opaque);
+                }
+                ev->accept();
+                return;
+            case Qt::Key_Plus:
+            case Qt::Key_Equal:
+                if (m_app->cb.on_zoom_in) {
+                    m_app->cb.on_zoom_in(m_app->cb.opaque);
+                }
+                ev->accept();
+                return;
+            case Qt::Key_Minus:
+                if (m_app->cb.on_zoom_out) {
+                    m_app->cb.on_zoom_out(m_app->cb.opaque);
+                }
+                ev->accept();
+                return;
+            case Qt::Key_0:
+                if (m_app->cb.on_zoom_fixed) {
+                    m_app->cb.on_zoom_fixed(m_app->cb.opaque);
+                }
+                ev->accept();
+                return;
+            default:
+                break;
+            }
+        }
+        if (m_app->cb.on_key) {
+            QByteArray text = ev->text().toUtf8();
+            m_app->cb.on_key(m_app->cb.opaque, m_vc->index,
+                             (int)ev->nativeScanCode(), (int)ev->key(), down,
+                             !text.isEmpty() && down, text.constData());
+        }
+        ev->accept();
+    }
+    void relayBtn(QMouseEvent *ev, bool down)
+    {
+        if (m_app->cb.on_mouse_button) {
+            m_app->cb.on_mouse_button(m_app->cb.opaque, m_vc->index,
+                                      (int)ev->position().x(),
+                                      (int)ev->position().y(),
+                                      (int)ev->buttons(), down,
+                                      width(), height());
+        }
+        ev->accept();
+    }
+
+    QtApp *m_app;
+    QtVcWidget *m_vc;
+};
+
+class QtQemuMainWindow : public QMainWindow
+{
+public:
+    explicit QtQemuMainWindow(QtApp *app) : QMainWindow(nullptr), m_app(app)
+    {
+        setAttribute(Qt::WA_DeleteOnClose, false);
+    }
+
+protected:
+    void closeEvent(QCloseEvent *ev) override
+    {
+        bool allow = true;
+        if (m_app->cb.on_window_close) {
+            m_app->cb.on_window_close(m_app->cb.opaque, &allow);
+        }
+        if (allow) {
+            if (m_app->cb.on_quit) {
+                m_app->cb.on_quit(m_app->cb.opaque);
+            }
+            ev->accept();
+        } else {
+            ev->ignore();
+        }
+    }
+
+private:
+    QtApp *m_app;
+};
