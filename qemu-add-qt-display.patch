+{
+    QtConsole *vc = container_of(dcl, QtConsole, dcl);
+    vc->ds = surf;
+    if (!surf) {
+        return;
+    }
+    qt_update_windowsize(vc);
+    qt_2d_update(dcl, 0, 0, surface_width(surf), surface_height(surf));
+}
