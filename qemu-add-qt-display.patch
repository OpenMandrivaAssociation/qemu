+static bool qt_2d_check_format(DisplayChangeListener *dcl,
+                               pixman_format_code_t format)
+{
+    (void)dcl;
+    return format == PIXMAN_x8r8g8b8 ||
+           format == PIXMAN_a8r8g8b8 ||
+           format == PIXMAN_x8b8g8r8 ||
+           format == PIXMAN_a8b8g8r8 ||
+           format == PIXMAN_b8g8r8x8 ||
+           format == PIXMAN_b8g8r8a8 ||
+           format == PIXMAN_r5g6b5;
+}
+
+static void qt_cursor_define(DisplayChangeListener *dcl, QEMUCursor *c)
+{
+    QtConsole *vc = container_of(dcl, QtConsole, dcl);
+
+    /*
+     * virtio-gpu feeds the classic cursor path (set_cursor + set_mouse),
+     * not only dpy_gl_cursor_dmabuf.  Install a host QCursor so the pointer
+     * is visible under absolute tablet (which hides the system arrow).
+     */
+    if (!c || c->width == 0 || c->height == 0) {
+        qt_vc_set_guest_cursor(vc->widget, NULL, 0, 0, 0, 0);
+        return;
+    }
+    qt_vc_set_guest_cursor(vc->widget, c->data, c->width, c->height,
+                           c->hot_x, c->hot_y);
+}
+
+static void qt_mouse_set(DisplayChangeListener *dcl, int x, int y, bool on)
+{
+    QtConsole *vc = container_of(dcl, QtConsole, dcl);
+    (void)x;
+    (void)y;
+    /*
+     * virtio-gpu passes resource_id as "on": 0 hides the cursor, non-zero
+     * shows the bitmap from the last dpy_cursor_define.
+     */
+    qt_vc_set_guest_cursor_hidden(vc->widget, !on);
+}
