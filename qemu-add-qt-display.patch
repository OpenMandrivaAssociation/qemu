+/*
+ * Map Qt nativeScanCode to a Linux input keycode.
+ *
+ * On X11, Qt reports the X keycode (linux + 8), same as the GTK
+ * "xorgevdev" path.  On Wayland it is typically already a linux code;
+ * treating codes >= 8 as X-style still yields a usable mapping for the
+ * common range.
+ */
+static unsigned int qt_native_to_linux(int native)
+{
+    if (native < 0) {
+        return KEY_RESERVED;
+    }
+    if (native < 8) {
+        return KEY_RESERVED;
+    }
+    return (unsigned int)native - 8;
+}
+
+static void cb_key(void *opaque, int vc_index, int native_scancode,
+                   int qkey, bool down, bool is_text, const char *text)
+{
+    QtDisplayState *s = opaque;
+    QtConsole *vc = qt_vc_by_index(s, vc_index);
+    unsigned int lnx;
+
+    if (!vc || !vc->kbd) {
+        return;
+    }
+
+    (void)qkey;
+
+    /* Qt::Key_Pause */
+    if (qkey == 0x01000008) {
+        lnx = KEY_PAUSE;
+    } else {
+        lnx = qt_native_to_linux(native_scancode);
+    }
+
+    if (lnx != KEY_RESERVED) {
+        qkbd_state_key_event(vc->kbd, lnx, down);
+    }
+
+    if (down && QEMU_IS_TEXT_CONSOLE(vc->dcl.con)) {
+        QemuTextConsole *tc = QEMU_TEXT_CONSOLE(vc->dcl.con);
+        bool ctrl = qkbd_state_modifier_get(vc->kbd, QKBD_MOD_CTRL);
+
+        if (lnx == KEY_ENTER) {
+            qemu_text_console_put_keysym(tc, '\n');
+        } else if (is_text && text && text[0]) {
+            qemu_text_console_put_string(tc, text, strlen(text));
+        } else if (lnx != KEY_RESERVED) {
+            qemu_text_console_put_linux(tc, lnx, ctrl);
+        }
+    }
+}
+
+static void qt_guest_fb_size(QtConsole *vc, int *fbw, int *fbh)
+{
+#if defined(CONFIG_OPENGL)
+    if (vc->opengl && vc->scanout_mode && vc->w > 0 && vc->h > 0) {
+        *fbw = vc->w;
+        *fbh = vc->h;
+        return;
+    }
+#endif
+    if (vc->ds) {
+        *fbw = surface_width(vc->ds);
+        *fbh = surface_height(vc->ds);
+        return;
+    }
+    *fbw = 640;
+    *fbh = 480;
+}
+
+/*
+ * Map widget (top-left) coordinates through the letterboxed guest image
+ * into guest framebuffer coordinates.
+ */
+static void qt_map_mouse(QtConsole *vc, int x, int y, int ww, int wh,
+                         int *gx, int *gy)
+{
+    int fbw, fbh, dw, dh, ox, oy;
+    double sx, sy, s;
+
+    qt_guest_fb_size(vc, &fbw, &fbh);
+    if (ww < 1) {
+        ww = 1;
+    }
+    if (wh < 1) {
+        wh = 1;
+    }
+
+    if (vc->s->free_scale || vc->s->full_screen) {
+        if (vc->s->keep_aspect_ratio) {
+            s = MIN((double)ww / fbw, (double)wh / fbh);
+            sx = sy = s;
+        } else {
+            sx = (double)ww / fbw;
+            sy = (double)wh / fbh;
+        }
+    } else {
+        sx = vc->scale_x;
+        sy = vc->scale_y;
+    }
+    if (sx < 1e-6) {
+        sx = 1.0;
+    }
+    if (sy < 1e-6) {
+        sy = 1.0;
+    }
+    dw = MAX(1, (int)(fbw * sx));
+    dh = MAX(1, (int)(fbh * sy));
+    ox = (ww - dw) / 2;
+    oy = (wh - dh) / 2;
+
+    *gx = (int)((x - ox) / sx);
+    *gy = (int)((y - oy) / sy);
+    if (*gx < 0) {
+        *gx = 0;
+    }
+    if (*gy < 0) {
+        *gy = 0;
+    }
+    if (*gx >= fbw) {
+        *gx = fbw - 1;
+    }
+    if (*gy >= fbh) {
+        *gy = fbh - 1;
+    }
+}
+
+static void qt_send_buttons(QtConsole *vc, int buttons)
+{
+    static uint32_t bmap[INPUT_BUTTON__MAX] = {
+        [INPUT_BUTTON_LEFT]   = 1,  /* Qt::LeftButton = 1 */
+        [INPUT_BUTTON_RIGHT]  = 2,  /* Qt::RightButton = 2 */
+        [INPUT_BUTTON_MIDDLE] = 4,  /* Qt::MiddleButton = 4 */
+    };
+    static uint32_t prev;
+
+    if (prev != (uint32_t)buttons) {
+        qemu_input_update_buttons(vc->dcl.con, bmap, prev, buttons);
+        prev = buttons;
+    }
+}
+
+static void cb_mouse_move(void *opaque, int vc_index, int x, int y,
+                          int buttons, int widget_w, int widget_h)
+{
+    QtDisplayState *s = opaque;
+    QtConsole *vc = qt_vc_by_index(s, vc_index);
+    int gx, gy;
+    int fbw, fbh;
+
+    if (!vc || !qemu_console_is_graphic(vc->dcl.con)) {
+        return;
+    }
+
+    qt_send_buttons(vc, buttons);
+
+    if (qemu_input_is_absolute(vc->dcl.con)) {
+        /*
+         * Absolute tablet: do NOT grabMouse().  grabMouse() freezes the
+         * cursor shape at grab time; later dpy_cursor_define cannot update
+         * it, which left users with a permanent BlankCursor.
+         */
+        qt_map_mouse(vc, x, y, widget_w, widget_h, &gx, &gy);
+        qt_guest_fb_size(vc, &fbw, &fbh);
+        qemu_input_queue_abs(vc->dcl.con, INPUT_AXIS_X, gx, 0, fbw);
+        qemu_input_queue_abs(vc->dcl.con, INPUT_AXIS_Y, gy, 0, fbh);
+        qemu_input_event_sync();
+        return;
+    }
+
+    /* Relative: only while host grab is active (click or Ctrl+Alt+G). */
+    if (s->ptr_owner != vc) {
+        return;
+    }
+
+    /*
+     * Deltas are in widget pixels (not letterboxed guest coords) so edge
+     * warping stays consistent with the coordinates Qt reports.
+     */
+    if (s->last_set) {
+        qemu_input_queue_rel(vc->dcl.con, INPUT_AXIS_X, x - s->last_x);
+        qemu_input_queue_rel(vc->dcl.con, INPUT_AXIS_Y, y - s->last_y);
+        qemu_input_event_sync();
+    }
+    s->last_x = x;
+    s->last_y = y;
+    s->last_set = true;
+
+    /*
+     * Warp to center when the pointer hits the widget edge so relative
+     * motion never stalls (and so the host cursor cannot wander onto the
+     * title bar and start a window drag).
+     */
+    if (qt_vc_warp_pointer_if_needed(vc->widget, x, y)) {
+        s->last_set = false;
+    }
+}
+
+static void cb_mouse_button(void *opaque, int vc_index, int x, int y,
+                            int buttons, bool down, int widget_w, int widget_h)
+{
+    QtDisplayState *s = opaque;
+    QtConsole *vc = qt_vc_by_index(s, vc_index);
+    int gx, gy;
+    int fbw, fbh;
+
+    if (!vc || !qemu_console_is_graphic(vc->dcl.con)) {
+        return;
+    }
+    /* Qt::LeftButton = 1 — relative mode needs an explicit grab. */
+    if (down && !s->ptr_owner && !qemu_input_is_absolute(vc->dcl.con) &&
+        (buttons & 1)) {
+        s->last_set = false;
+        qt_set_grab(s, true);
+        /* Swallow the grab click (same as GTK); next events go to guest. */
+        return;
+    }
+    if (!qemu_input_is_absolute(vc->dcl.con) && s->ptr_owner != vc) {
+        return;
+    }
+
+    qt_send_buttons(vc, buttons);
+
+    if (qemu_input_is_absolute(vc->dcl.con)) {
+        qt_map_mouse(vc, x, y, widget_w, widget_h, &gx, &gy);
+        qt_guest_fb_size(vc, &fbw, &fbh);
+        qemu_input_queue_abs(vc->dcl.con, INPUT_AXIS_X, gx, 0, fbw);
+        qemu_input_queue_abs(vc->dcl.con, INPUT_AXIS_Y, gy, 0, fbh);
+    }
+    /* Relative mode: buttons only (motion is separate); still sync. */
+    qemu_input_event_sync();
+}
+
+/*
+ * Tell the guest (virtio-gpu ui_info) the *display widget* size (not the
+ * outer QMainWindow).  The menu bar must not be included, or the guest
+ * desktop is taller than the drawable area and the panel is clipped.
+ */
+static void qt_set_ui_size(QtConsole *vc, int width, int height, bool delay)
+{
+    QemuUIInfo info;
+
+    if (!vc || !vc->dcl.con) {
+        return;
+    }
+    if (!qemu_console_ui_info_supported(vc->dcl.con)) {
+        return;
+    }
+    if (width < 1 || height < 1) {
+        return;
+    }
+
+    /*
+     * Match GTK: when not free-scaling, report guest-logical size
+     * (widget / scale).  With free_scale / zoom-to-fit, report the widget
+     * size so the guest can resize to the window.
+     */
+    if (!vc->s->free_scale && !vc->s->full_screen) {
+        if (vc->scale_x > 1e-6) {
+            width = (int)(width / vc->scale_x);
+        }
+        if (vc->scale_y > 1e-6) {
+            height = (int)(height / vc->scale_y);
+        }
+    }
+
+    info = *qemu_console_get_ui_info(vc->dcl.con);
+    info.width = width;
+    info.height = height;
+    qemu_console_set_ui_info(vc->dcl.con, &info, delay);
+}
+
+static void cb_resize(void *opaque, int vc_index, int width, int height)
+{
+    QtDisplayState *s = opaque;
+    QtConsole *vc = qt_vc_by_index(s, vc_index);
+
+    if (!vc) {
+        return;
+    }
+    /* Debounce interactive resizes; still one second of settle like GTK. */
+    qt_set_ui_size(vc, width, height, true);
+}
+
+static void cb_mouse_wheel(void *opaque, int vc_index, int dx, int dy)
+{
+    QtDisplayState *s = opaque;
+    QtConsole *vc = qt_vc_by_index(s, vc_index);
+    InputButton btn;
+    if (!vc || !qemu_console_is_graphic(vc->dcl.con)) {
+        return;
+    }
+    if (dy > 0) {
+        btn = INPUT_BUTTON_WHEEL_UP;
+    } else if (dy < 0) {
+        btn = INPUT_BUTTON_WHEEL_DOWN;
+    } else if (dx < 0) {
+        btn = INPUT_BUTTON_WHEEL_RIGHT;
+    } else if (dx > 0) {
+        btn = INPUT_BUTTON_WHEEL_LEFT;
+    } else {
+        return;
+    }
+    qemu_input_queue_btn(vc->dcl.con, btn, true);
+    qemu_input_event_sync();
+    qemu_input_queue_btn(vc->dcl.con, btn, false);
+    qemu_input_event_sync();
+}
