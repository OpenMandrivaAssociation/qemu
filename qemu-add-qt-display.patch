+ */
+bool qt_app_gl_has_egl(QtApp *app);
+/* EGLDisplay / EGLConfig / EGLContext as void* for the C side. */
+void *qt_app_gl_egl_display(QtApp *app);
+void *qt_app_gl_egl_config(QtApp *app);
+/* Share context: prefer the console widget, else the master offscreen. */
+void *qt_vc_gl_share_egl_context(QtVcWidget *vc);
+/* QOpenGLWidget::defaultFramebufferObject() — not GL's FBO 0 */
+unsigned qt_vc_gl_default_framebuffer(QtVcWidget *vc);
+/* Device-pixel size of the widget FBO (width/height * DPR, rounded). */
+void qt_vc_gl_fb_size(QtVcWidget *vc, int *fb_w, int *fb_h);
+int qt_vc_widget_width(QtVcWidget *vc);
+int qt_vc_widget_height(QtVcWidget *vc);
+double qt_vc_device_pixel_ratio(QtVcWidget *vc);
+/* Push current widget sizes to on_resize (after layout settles). */
+void qt_app_notify_sizes(QtApp *app);
+void *qt_app_gl_get_egl_display(QtApp *app);
+
+/* Detach / reattach tab */
+void qt_vc_detach(QtApp *app, QtVcWidget *vc);
+void qt_vc_reattach(QtApp *app, QtVcWidget *vc);
