+static void qt_2d_update(DisplayChangeListener *dcl,
+                         int x, int y, int w, int h)
+{
+    QtConsole *vc = container_of(dcl, QtConsole, dcl);
+    (void)x;
+    (void)y;
+    (void)w;
+    (void)h;
+    if (!vc->ds || !vc->widget) {
+        return;
+    }
+    qt_vc_set_framebuffer(vc->widget, surface_data(vc->ds),
+                          surface_width(vc->ds), surface_height(vc->ds),
+                          surface_stride(vc->ds),
+                          surface_format(vc->ds));
+}
