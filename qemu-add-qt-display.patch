+
+static void setup_gl_format(QSurfaceFormat *fmt, bool gl_es)
+{
+    fmt->setDepthBufferSize(24);
+    fmt->setStencilBufferSize(8);
+    /*
+     * Keep an alpha channel.  Some Wayland/X11 screenshot paths sample an
+     * RGBA window buffer; an XRGB-only GL config often captures as solid black
+     * even though on-screen presentation looks fine.  We always clear alpha=1.
+     */
+    fmt->setAlphaBufferSize(8);
+    fmt->setSwapBehavior(QSurfaceFormat::DoubleBuffer);
+    fmt->setSwapInterval(0);
+    if (gl_es) {
+        fmt->setRenderableType(QSurfaceFormat::OpenGLES);
+        fmt->setVersion(3, 0);
+    } else {
+        fmt->setRenderableType(QSurfaceFormat::OpenGL);
+        fmt->setProfile(QSurfaceFormat::CoreProfile);
+        fmt->setVersion(3, 3);
+    }
+}
+
+static bool create_master_gl_context(QtApp *app, const QtAppOptions *opts,
+                                     QOpenGLContext *share_with)
+{
+    QSurfaceFormat fmt;
+    setup_gl_format(&fmt, opts->gl_es);
+    QSurfaceFormat::setDefaultFormat(fmt);
+
+    app->gl_surface = new QOffscreenSurface();
+    app->gl_surface->setFormat(fmt);
+    app->gl_surface->create();
+    if (!app->gl_surface->isValid()) {
+        std::fprintf(stderr, "qt: failed to create offscreen GL surface\n");
+        return false;
+    }
+
+    app->gl_master = new QOpenGLContext();
+    app->gl_master->setFormat(fmt);
+    /*
+     * Share with the QOpenGLWidget context when available so virgl textures
+     * (created on guest contexts that share master) are visible when paintGL
+     * blits them on the widget context.
+     */
+    if (share_with) {
+        app->gl_master->setShareContext(share_with);
+    }
+    if (!app->gl_master->create()) {
+        /* Fallback to GLES if core desktop GL fails */
+        if (!opts->gl_es) {
+            setup_gl_format(&fmt, true);
+            QSurfaceFormat::setDefaultFormat(fmt);
+            app->gl_surface->destroy();
+            app->gl_surface->setFormat(fmt);
+            app->gl_surface->create();
+            app->gl_master->setFormat(fmt);
+            if (share_with) {
+                app->gl_master->setShareContext(share_with);
+            }
+        }
+        if (!app->gl_master->create()) {
+            std::fprintf(stderr, "qt: failed to create master OpenGL context\n");
+            return false;
+        }
+    }
+
+    if (!app->gl_master->makeCurrent(app->gl_surface)) {
+        std::fprintf(stderr, "qt: failed to activate master OpenGL context\n");
+        return false;
+    }
+
+    /* Touch the context so epoxy can resolve its dispatch tables. */
+    auto *funcs = app->gl_master->functions();
+    if (funcs) {
+        funcs->initializeOpenGLFunctions();
+    }
+
+    return QOpenGLContext::currentContext() != nullptr;
+}
+
+QtApp *qt_app_create(const QtAppOptions *opts, const QtAppCallbacks *cb)
+{
+    static int argc = 1;
+    static char prog[] = "qemu";
+    static char *argv[] = { prog, nullptr };
+
+    auto *app = new QtApp();
+    g_app = app;
+    app->cb = *cb;
+    app->opts = *opts;
+    app->owns_app = false;
+    app->gl_master = nullptr;
+    app->gl_surface = nullptr;
+
+    /*
+     * Prefer the XCB (X11) platform when the user has not chosen one and a
+     * DISPLAY is available (typical on desktop Wayland via XWayland).
+     *
+     * QWidget::grabMouse() and QCursor::setPos() are no-ops on the Wayland
+     * QPA — relative mouse (FPS / grab-the-cursor games) cannot confine the
+     * pointer, so the host cursor escapes and ends up dragging the window.
+     * X11 grab + warp works.  Override with QT_QPA_PLATFORM=wayland if needed.
+     */
+    if (qEnvironmentVariableIsEmpty("QT_QPA_PLATFORM") &&
+        qEnvironmentVariableIsSet("DISPLAY")) {
+        qputenv("QT_QPA_PLATFORM", "xcb");
+    }
+
+    /*
+     * Prefer EGL over GLX so epoxy and QEMU's dmabuf helpers work.  Must be
+     * set before QApplication is constructed.  Harmless on Wayland (EGL).
+     */
+    if (opts->use_opengl) {
+        qputenv("QT_XCB_GL_INTEGRATION", "xcb_egl");
+        /*
+         * Share textures/FBOs between the master context (used for guest GL
+         * before widgets exist) and every QOpenGLWidget context.
+         */
+        QCoreApplication::setAttribute(Qt::AA_ShareOpenGLContexts);
+    }
+
+    QLocale::setDefault(QLocale::c());
+
+    if (!QApplication::instance()) {
+        if (opts->use_opengl) {
+            QSurfaceFormat fmt;
+            setup_gl_format(&fmt, opts->gl_es);
+            QSurfaceFormat::setDefaultFormat(fmt);
+        }
+        app->app = new QApplication(argc, argv);
+        app->owns_app = true;
+        setlocale(LC_NUMERIC, "C");
+    } else {
+        app->app = qobject_cast<QApplication *>(QApplication::instance());
+    }
+    QApplication::setApplicationName(QStringLiteral("qemu"));
+    QApplication::setDesktopFileName(QStringLiteral("qemu"));
+
+    if (QGuiApplication::platformName() == QLatin1String("wayland")) {
+        static bool warned;
+        if (!warned) {
+            warned = true;
+            std::fprintf(stderr,
+                "qt: Wayland QPA: mouse grab/warp unavailable - relative "
+                "mouse (game cursor grab) will not confine the pointer. "
+                "Restart with QT_QPA_PLATFORM=xcb (XWayland) for games.\n");
+        }
+    }
+
+    /*
+     * Create the master context now (before any widgets).  With
+     * AA_ShareOpenGLContexts, later QOpenGLWidget contexts join the same
+     * share group.  Guest/virgl contexts share with master explicitly.
+     */
+    if (opts->use_opengl && !create_master_gl_context(app, opts, nullptr)) {
+        std::fprintf(stderr, "qt: OpenGL initialization failed\n");
+    }
+
+    app->window = new QtQemuMainWindow(app);
+    app->window->setWindowTitle(
+        opts->window_title ? QString::fromUtf8(opts->window_title)
+                           : QStringLiteral("QEMU"));
+
+    app->tabs = new QTabWidget(app->window);
+    app->tabs->setDocumentMode(true);
+    app->tabs->tabBar()->setVisible(opts->show_tabs);
+    app->window->setCentralWidget(app->tabs);
+
+    QObject::connect(app->tabs, &QTabWidget::currentChanged, [app](int index) {
+        if (index < 0 || !app->cb.on_switch_vc) {
+            return;
+        }
+        for (QtVcWidget *vc : app->vcs) {
+            if (app->tabs->indexOf(vc->as_qwidget) == index) {
+                app->cb.on_switch_vc(app->cb.opaque, vc->index);
+                break;
+            }
+        }
+    });
+
+    setup_menus(app);
+
+    if (opts->full_screen) {
+        app->fullscreen_action->setChecked(true);
+    }
+
+    /*
+     * Size the window so the *central display* is ~1024x768, not the outer
+     * frame.  resize(w,h) on QMainWindow includes the menu bar; if we ignore
+     * that, the guest is told a height that is menubar-pixels too large and
+     * the bottom of the guest (LXQt panel) is clipped.
+     */
+    {
+        const int content_w = 1024;
+        const int content_h = 768;
+        app->window->resize(content_w, content_h);
+        /* After menus exist, grow the frame so central area keeps content_h. */
+        int menu_h = app->menu_bar && app->menu_bar->isVisible()
+                         ? app->menu_bar->sizeHint().height()
+                         : 0;
+        if (menu_h > 0) {
+            app->window->resize(content_w, content_h + menu_h);
+        }
+    }
+    return app;
+}
+
+void qt_app_destroy(QtApp *app)
+{
+    if (!app) {
+        return;
+    }
+    for (QtVcWidget *vc : app->vcs) {
+        free(vc->label);
+        delete vc->guest_cursor;
+        vc->guest_cursor = nullptr;
+        delete vc;
+    }
+    if (app->gl_master) {
+        app->gl_master->doneCurrent();
+        delete app->gl_master;
+        app->gl_master = nullptr;
+    }
+    delete app->gl_surface;
+    app->gl_surface = nullptr;
+    delete app->window;
+    if (app->owns_app) {
+        delete app->app;
+    }
+    if (g_app == app) {
+        g_app = nullptr;
+    }
+    delete app;
+}
+
+void qt_app_show(QtApp *app)
+{
+    app->window->show();
+    /* Realize GL widgets first so they own a real QOpenGLContext. */
+    app->app->processEvents(QEventLoop::ExcludeUserInputEvents);
+    for (QtVcWidget *vc : app->vcs) {
+        if (vc->gl_widget) {
+            qt_vc_gl_realize(vc);
+        }
+    }
+
+    if (app->opts.use_opengl && app->gl_master) {
+        for (QtVcWidget *vc : app->vcs) {
+            if (vc->gl_widget && vc->gl_widget->context() &&
+                vc->gl_widget->context()->isValid() &&
+                !QOpenGLContext::areSharing(app->gl_master,
+                                            vc->gl_widget->context())) {
+                std::fprintf(stderr,
+                             "qt: warning: display widget GL context is not "
+                             "sharing with master — guest scanout may be blank\n");
+                break;
+            }
+        }
+    }
+
+    /*
+     * Correct outer window size so the central display area is the size we
+     * advertised (menubar/frame chrome is outside that).  Without this the
+     * guest mode matches a too-tall guess and the LXQt panel is clipped.
+     */
+    if (app->tabs) {
+        const QSize want(1024, 768);
+        const QSize have = app->tabs->size();
+        if (have.width() > 0 && have.height() > 0) {
+            app->window->resize(app->window->size() + (want - have));
+            app->app->processEvents(QEventLoop::ExcludeUserInputEvents);
+        }
+    }
+    /*
+     * Layout is final only after show+processEvents.  Re-push sizes so
+     * virtio-gpu ui_info matches the real central-widget area.
+     */
+    qt_app_notify_sizes(app);
+}
+
+void qt_app_notify_sizes(QtApp *app)
+{
+    if (!app || !app->cb.on_resize) {
+        return;
+    }
+    for (QtVcWidget *vc : app->vcs) {
+        if (!vc->as_qwidget) {
+            continue;
+        }
+        int w = vc->as_qwidget->width();
+        int h = vc->as_qwidget->height();
+        if (w > 0 && h > 0) {
+            app->cb.on_resize(app->cb.opaque, vc->index, w, h);
+        }
+    }
+}
+
+bool qt_app_gl_ready(QtApp *app)
+{
+    return app && app->gl_master && app->gl_master->isValid();
+}
+
+void *qt_app_gl_get_egl_display(QtApp *app)
+{
+    return qt_app_gl_egl_display(app);
+}
+
+static QNativeInterface::QEGLContext *qt_qegl(QOpenGLContext *ctx)
+{
+    if (!ctx || !ctx->isValid()) {
+        return nullptr;
+    }
+    return ctx->nativeInterface<QNativeInterface::QEGLContext>();
+}
+
+static QOpenGLContext *qt_pick_share_qctx(QtVcWidget *vc)
+{
+    if (vc && vc->gl_widget && vc->gl_widget->context() &&
+        vc->gl_widget->context()->isValid()) {
+        return vc->gl_widget->context();
+    }
+    if (g_app && g_app->gl_master && g_app->gl_master->isValid()) {
+        return g_app->gl_master;
+    }
+    return nullptr;
+}
+
+bool qt_app_gl_has_egl(QtApp *app)
+{
+    if (!app || !app->gl_master) {
+        return false;
+    }
+    /* Force the master current so the native EGL interface is populated. */
+    if (app->gl_surface) {
+        app->gl_master->makeCurrent(app->gl_surface);
+    }
+    return qt_qegl(app->gl_master) != nullptr;
+}
+
+void *qt_app_gl_egl_display(QtApp *app)
+{
+    if (!app || !app->gl_master) {
+        return nullptr;
+    }
+    if (app->gl_surface) {
+        app->gl_master->makeCurrent(app->gl_surface);
+    }
+    if (auto *iface = qt_qegl(app->gl_master)) {
+        return iface->display();
+    }
+    return nullptr;
+}
+
+void *qt_app_gl_egl_config(QtApp *app)
+{
+    if (!app || !app->gl_master) {
+        return nullptr;
+    }
+    if (app->gl_surface) {
+        app->gl_master->makeCurrent(app->gl_surface);
+    }
+    if (auto *iface = qt_qegl(app->gl_master)) {
+        return iface->config();
+    }
+    return nullptr;
+}
+
+void *qt_vc_gl_share_egl_context(QtVcWidget *vc)
+{
+    QOpenGLContext *qctx = qt_pick_share_qctx(vc);
+    if (!qctx) {
+        return nullptr;
+    }
+    /*
+     * Ensure the context has been made current at least once so Qt builds
+     * the QEGLContext native interface.
+     */
+    if (g_app && g_app->gl_surface && qctx == g_app->gl_master) {
+        qctx->makeCurrent(g_app->gl_surface);
+    } else if (vc && vc->gl_widget && qctx == vc->gl_widget->context()) {
+        vc->gl_widget->makeCurrent();
+    }
+    if (auto *iface = qt_qegl(qctx)) {
+        return iface->nativeContext();
+    }
+    return nullptr;
+}
+
+void qt_app_process_events(QtApp *app)
+{
+    if (app && app->app) {
+        /*
+         * Drain the queue (including paint events scheduled via update()).
+         * A 1ms budget is too short and left the GL widget black under load.
+         */
+        app->app->processEvents(QEventLoop::AllEvents);
+    }
+}
+
+void qt_app_set_caption(QtApp *app, const char *title)
+{
+    app->window->setWindowTitle(QString::fromUtf8(title));
+}
+
+void qt_app_set_pause_checked(QtApp *app, bool paused)
+{
+    app->pause_action->blockSignals(true);
+    app->pause_action->setChecked(paused);
+    app->pause_action->blockSignals(false);
+}
+
+void qt_app_set_grab_checked(QtApp *app, bool grabbed)
+{
+    app->grab_action->blockSignals(true);
+    app->grab_action->setChecked(grabbed);
+    app->grab_action->blockSignals(false);
+}
+
+void qt_app_set_fullscreen(QtApp *app, bool on)
+{
+    app->fullscreen_action->setChecked(on);
+}
+
+void qt_app_set_menubar_visible(QtApp *app, bool on)
+{
+    app->show_menubar_action->setChecked(on);
+}
+
+void qt_app_set_tabs_visible(QtApp *app, bool on)
+{
+    app->show_tabs_action->setChecked(on);
+}
+
+QtVcWidget *qt_app_add_vc(QtApp *app, int index, const char *label, bool graphic)
+{
+    auto *vc = new QtVcWidget();
+    memset(static_cast<void *>(vc), 0, sizeof(QtVcWidget));
+    /* re-init non-trivial fields after memset */
+    vc->index = index;
+    vc->graphic = graphic;
+    vc->use_gl = app->opts.use_opengl && graphic;
+    vc->scale_x = 1.0;
+    vc->scale_y = 1.0;
+    vc->keep_aspect = true;
+    vc->label = label ? strdup(label) : strdup("vga");
+    vc->detached = nullptr;
+
+    if (vc->use_gl) {
+        vc->gl_widget = new GLDisplayWidget(app, vc);
+        vc->widget = nullptr;
+        vc->as_qwidget = vc->gl_widget;
+    } else {
+        vc->widget = new DisplayWidget(app, vc);
+        vc->gl_widget = nullptr;
+        vc->as_qwidget = vc->widget;
+    }
+
+    app->tabs->addTab(vc->as_qwidget, QString::fromUtf8(vc->label));
+    app->vcs.push_back(vc);
+
+    QAction *act = app->view_menu->addAction(
+        QStringLiteral("%1. %2").arg(index + 1).arg(QString::fromUtf8(vc->label)));
+    act->setCheckable(true);
+    act->setActionGroup(app->vc_group);
+    if (index == 0) {
+        act->setChecked(true);
+    }
+    if (index < 9) {
+        act->setShortcut(
+            QKeySequence(QStringLiteral("Ctrl+Alt+%1").arg(index + 1)));
+    }
+    QObject::connect(act, &QAction::triggered, [app, vc]() {
+        qt_app_set_current_vc(app, vc->index);
+        qt_vc_set_focus(vc);
+        if (app->cb.on_switch_vc) {
+            app->cb.on_switch_vc(app->cb.opaque, vc->index);
+        }
+    });
+
+    return vc;
+}
+
+void qt_app_set_current_vc(QtApp *app, int index)
+{
+    for (QtVcWidget *vc : app->vcs) {
+        if (vc->index == index && !vc->detached) {
+            app->tabs->setCurrentWidget(vc->as_qwidget);
+            break;
+        }
+    }
+}
+
+int qt_app_current_vc(QtApp *app)
+{
+    QWidget *w = app->tabs->currentWidget();
+    for (QtVcWidget *vc : app->vcs) {
+        if (vc->as_qwidget == w) {
+            return vc->index;
+        }
+    }
+    return 0;
+}
+
+void qt_vc_set_framebuffer(QtVcWidget *vc, const void *data,
+                           int width, int height, int stride,
+                           uint32_t pixman_format)
+{
+    if (!vc || !vc->widget || !data || width <= 0 || height <= 0) {
+        return;
+    }
+
+    QImage::Format fmt = QImage::Format_RGB32;
+    if (pixman_format == QT_PIXMAN_r5g6b5) {
+        fmt = QImage::Format_RGB16;
+    }
+
+    QImage img(static_cast<const uchar *>(data), width, height, stride, fmt);
+    vc->widget->setImage(img.copy());
+}
+
+void qt_vc_update(QtVcWidget *vc)
+{
+    if (vc && vc->as_qwidget) {
+        vc->as_qwidget->update();
+    }
+}
+
+void qt_vc_set_scales(QtVcWidget *vc, double sx, double sy,
+                      bool free_scale, bool keep_aspect)
+{
+    if (!vc) {
+        return;
+    }
+    vc->scale_x = sx;
+    vc->scale_y = sy;
+    vc->free_scale = free_scale;
+    vc->keep_aspect = keep_aspect;
+    if (vc->widget) {
+        vc->widget->setScales(sx, sy, free_scale, keep_aspect);
+    } else {
+        qt_vc_update(vc);
+    }
+}
+
+void qt_vc_set_min_size(QtVcWidget *vc, int w, int h)
+{
+    if (vc && vc->as_qwidget) {
+        vc->as_qwidget->setMinimumSize(w, h);
+    }
+}
+
+static QCursor qt_vc_current_cursor(QtVcWidget *vc)
+{
+    if (vc->guest_cursor_hidden) {
+        return QCursor(Qt::BlankCursor);
+    }
+    if (vc->guest_cursor) {
+        return *vc->guest_cursor;
+    }
+    /*
+     * Absolute tablet used to force BlankCursor with no guest shape →
+     * invisible pointer.  Fall back to a normal arrow so the UI is usable
+     * even if the guest never defines a cursor bitmap.
+     */
+    if (vc->prefer_blank) {
+        return QCursor(Qt::ArrowCursor);
+    }
+    return QCursor(Qt::ArrowCursor);
+}
+
+static void qt_vc_apply_cursor(QtVcWidget *vc)
+{
+    if (!vc || !vc->as_qwidget) {
+        return;
+    }
+    QCursor cur = qt_vc_current_cursor(vc);
+    /*
+     * grabMouse() installs its own cursor that setCursor() does not replace.
+     * Re-grab with the new shape when a grab is active.
+     */
+    if (vc->mouse_grabbed) {
+        vc->as_qwidget->releaseMouse();
+        vc->as_qwidget->grabMouse(cur);
+    } else {
+        vc->as_qwidget->setCursor(cur);
+    }
+}
+
+void qt_vc_set_cursor_blank(QtVcWidget *vc, bool blank)
+{
+    if (!vc) {
+        return;
+    }
+    vc->prefer_blank = blank;
+    qt_vc_apply_cursor(vc);
+}
+
+void qt_vc_set_guest_cursor_hidden(QtVcWidget *vc, bool hidden)
+{
+    if (!vc) {
+        return;
+    }
+    vc->guest_cursor_hidden = hidden;
+    qt_vc_apply_cursor(vc);
+}
+
+void qt_vc_set_guest_cursor(QtVcWidget *vc, const uint32_t *rgba,
+                            int width, int height, int hot_x, int hot_y)
+{
+    if (!vc) {
+        return;
+    }
+
+    delete vc->guest_cursor;
+    vc->guest_cursor = nullptr;
+
+    if (rgba && width > 0 && height > 0) {
+        /*
+         * virtio-gpu / pixman cursor pixels are ARGB32 (LE bytes B,G,R,A).
+         * Copy — the guest may free the buffer after this returns.
+         */
+        QImage img(reinterpret_cast<const uchar *>(rgba),
+                   width, height, width * 4, QImage::Format_ARGB32);
+        QPixmap pm = QPixmap::fromImage(img.copy());
+        if (hot_x < 0) {
+            hot_x = 0;
+        }
+        if (hot_y < 0) {
+            hot_y = 0;
+        }
+        if (hot_x >= width) {
+            hot_x = width - 1;
+        }
+        if (hot_y >= height) {
+            hot_y = height - 1;
+        }
+        vc->guest_cursor = new QCursor(pm, hot_x, hot_y);
+        vc->guest_cursor_hidden = false;
+    }
+
+    qt_vc_apply_cursor(vc);
+}
+
+void qt_vc_grab_keyboard(QtVcWidget *vc, bool grab)
+{
+    if (!vc || !vc->as_qwidget) {
+        return;
+    }
+    if (grab) {
+        vc->as_qwidget->grabKeyboard();
+        vc->as_qwidget->setFocus(Qt::OtherFocusReason);
+    } else {
+        vc->as_qwidget->releaseKeyboard();
+    }
+}
+
+void qt_vc_grab_mouse(QtVcWidget *vc, bool grab, bool blank_cursor)
+{
+    if (!vc || !vc->as_qwidget) {
+        return;
+    }
+    if (grab) {
+        vc->prefer_blank = blank_cursor;
+        vc->mouse_grabbed = true;
+        /*
+         * Blank the cursor for relative grab so the host arrow does not
+         * sit on top of the guest's idea of a grabbed pointer.  Also push
+         * an override cursor in case grabMouse is ignored (Wayland).
+         */
+        QCursor cur = blank_cursor ? QCursor(Qt::BlankCursor)
+                                   : qt_vc_current_cursor(vc);
+        vc->as_qwidget->setCursor(cur);
+        QGuiApplication::setOverrideCursor(cur);
+        vc->as_qwidget->grabMouse(cur);
+        vc->as_qwidget->setFocus(Qt::OtherFocusReason);
+        /* Seed at center so the first relative delta is small. */
+        QPoint c = vc->as_qwidget->mapToGlobal(
+            vc->as_qwidget->rect().center());
+        QCursor::setPos(c);
+    } else {
+        vc->mouse_grabbed = false;
+        vc->as_qwidget->releaseMouse();
+        while (QGuiApplication::overrideCursor()) {
+            QGuiApplication::restoreOverrideCursor();
+        }
+        qt_vc_apply_cursor(vc);
+    }
+}
+
+void qt_vc_set_focus(QtVcWidget *vc)
+{
+    if (vc && vc->as_qwidget) {
+        vc->as_qwidget->setFocus(Qt::OtherFocusReason);
+    }
+}
+
+bool qt_vc_warp_pointer_if_needed(QtVcWidget *vc, int x, int y)
+{
+    if (!vc || !vc->as_qwidget || !vc->mouse_grabbed) {
+        return false;
+    }
+    QWidget *w = vc->as_qwidget;
+    const int ww = w->width();
+    const int wh = w->height();
+    if (ww < 3 || wh < 3) {
+        return false;
+    }
+    /*
+     * With an X11 grab, motion can be reported outside the widget.  Warp
+     * back to the center before the pointer hits an "invisible wall" at
+     * the screen edge (same idea as GTK gd_motion_event).
+     */
+    if (x > 0 && x < ww - 1 && y > 0 && y < wh - 1) {
+        return false;
+    }
+    QPoint c = w->mapToGlobal(QPoint(ww / 2, wh / 2));
+    QCursor::setPos(c);
+    return true;
+}
+
+static QOpenGLContext *share_context_for(QtVcWidget *vc)
+{
+    if (!vc) {
+        return g_app ? g_app->gl_master : nullptr;
+    }
+    if (vc->gl_widget && vc->gl_widget->context() &&
+        vc->gl_widget->context()->isValid()) {
+        return vc->gl_widget->context();
+    }
+    return (g_app && g_app->gl_master) ? g_app->gl_master : nullptr;
+}
+
+bool qt_vc_gl_realize(QtVcWidget *vc)
+{
+    if (!vc) {
+        return false;
+    }
+    if (vc->gl_widget) {
+        if (vc->gl_widget->ensureContext()) {
+            return true;
+        }
+    }
+    /* Fall back to master offscreen context */
+    if (g_app && g_app->gl_master && g_app->gl_surface) {
+        return g_app->gl_master->makeCurrent(g_app->gl_surface);
+    }
+    return false;
+}
+
+bool qt_vc_gl_make_current(QtVcWidget *vc)
+{
+    if (!vc) {
+        return false;
+    }
+
+    /* Prefer the widget context once it exists (for on-screen FBO). */
+    if (vc->gl_widget) {
+        if (vc->gl_widget->ensureContext()) {
+            return true;
+        }
+    }
+
+    /* Before the widget is realized, use the master offscreen context. */
+    if (g_app && g_app->gl_master && g_app->gl_surface) {
+        if (g_app->gl_master->makeCurrent(g_app->gl_surface) &&
+            QOpenGLContext::currentContext()) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void qt_vc_gl_done_current(QtVcWidget *vc)
+{
+    if (QOpenGLContext *cur = QOpenGLContext::currentContext()) {
+        cur->doneCurrent();
+    }
+    (void)vc;
+}
+
+void qt_vc_gl_request_update(QtVcWidget *vc)
+{
+    if (vc && vc->gl_widget) {
+        vc->gl_widget->update();
+    }
+}
+
+unsigned qt_vc_gl_default_framebuffer(QtVcWidget *vc)
+{
+    if (vc && vc->gl_widget) {
+        return vc->gl_widget->defaultFramebufferObject();
+    }
+    return 0;
+}
+
+void qt_vc_gl_fb_size(QtVcWidget *vc, int *fb_w, int *fb_h)
+{
+    if (!vc || !vc->gl_widget || !fb_w || !fb_h) {
+        if (fb_w) {
+            *fb_w = 0;
+        }
+        if (fb_h) {
+            *fb_h = 0;
+        }
+        return;
+    }
+    /*
+     * Must match QOpenGLWidget's FBO exactly.  Using only width()/height()
+     * (logical pixels) paints into the bottom portion of a HiDPI FBO; the
+     * rest stays uncleared → transparent, “upper half only”, see-through
+     * when dragging the window.
+     */
+    const qreal dpr = vc->gl_widget->devicePixelRatioF();
+    *fb_w = qMax(1, qRound(vc->gl_widget->width() * dpr));
+    *fb_h = qMax(1, qRound(vc->gl_widget->height() * dpr));
+}
+
+void *qt_vc_gl_context(QtVcWidget *vc)
+{
+    QOpenGLContext *ctx = share_context_for(vc);
+    return ctx;
+}
+
+int qt_vc_widget_width(QtVcWidget *vc)
+{
+    return vc && vc->as_qwidget ? vc->as_qwidget->width() : 0;
+}
+
+int qt_vc_widget_height(QtVcWidget *vc)
+{
+    return vc && vc->as_qwidget ? vc->as_qwidget->height() : 0;
+}
+
+double qt_vc_device_pixel_ratio(QtVcWidget *vc)
+{
+    return vc && vc->as_qwidget ? vc->as_qwidget->devicePixelRatioF() : 1.0;
+}
+
+void qt_vc_detach(QtApp *app, QtVcWidget *vc)
+{
+    if (!vc || vc->detached) {
+        return;
+    }
+    int idx = app->tabs->indexOf(vc->as_qwidget);
+    if (idx < 0) {
+        return;
+    }
+    app->tabs->removeTab(idx);
+    auto *dw = new QMainWindow();
+    dw->setWindowTitle(QString::fromUtf8(vc->label));
+    dw->setCentralWidget(vc->as_qwidget);
+    vc->as_qwidget->show();
+    dw->resize(640, 480);
+    dw->show();
+    vc->detached = dw;
+
+    class Guard : public QObject {
+    public:
+        Guard(QtApp *a, QtVcWidget *v) : QObject(v->detached), app(a), vc(v)
+        {
+            v->detached->installEventFilter(this);
+        }
+        bool eventFilter(QObject *obj, QEvent *ev) override
+        {
+            if (obj == vc->detached && ev->type() == QEvent::Close) {
+                qt_vc_reattach(app, vc);
+            }
+            return QObject::eventFilter(obj, ev);
+        }
+        QtApp *app;
+        QtVcWidget *vc;
+    };
+    new Guard(app, vc);
+}
+
+void qt_vc_reattach(QtApp *app, QtVcWidget *vc)
+{
+    if (!vc || !vc->detached) {
+        return;
+    }
+    QMainWindow *dw = vc->detached;
+    vc->as_qwidget->setParent(nullptr);
+    app->tabs->addTab(vc->as_qwidget, QString::fromUtf8(vc->label));
+    vc->as_qwidget->show();
+    vc->detached = nullptr;
+    dw->deleteLater();
+}
